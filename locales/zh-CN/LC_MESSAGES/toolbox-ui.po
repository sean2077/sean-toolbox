msgid "Enable cross-machine clipboard"
msgstr "启用跨机剪贴板"

#: crates/toolbox-ui/ui/main.slint:93
msgctxt "ui.clipboard.enable_hint"
msgid "Uses an encrypted Noise connection. The key file is separate from config.json and is never shown here."
msgstr "使用 Noise 加密连接。密钥文件与 config.json 分开保存，不会在此显示。"

