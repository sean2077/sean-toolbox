                                                FieldLabel { text: @tr("ui.main.display_name" => "Display name"); }
                                                profile-name := LineEdit { height: 36px; text <=> root.form-name; accessible-label: @tr("ui.main.display_name" => "Display name"); placeholder-text: @tr("ui.main.e_g_vs_code" => "e.g. VS Code"); enabled: !root.saving; edited => { root.profile-changed(); } }
                                                if root.form-name-error != "": Caption { text: root.form-name-error; color: Theme.danger; }
                                                FieldLabel { text: @tr("ui.main.shortcut_optional" => "Shortcut · optional"); }
