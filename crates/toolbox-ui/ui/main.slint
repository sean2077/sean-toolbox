import { CheckBox, ComboBox, LineEdit, ScrollView, TextEdit, AboutSlint, Switch, Spinner, SpinBox } from "std-widgets.slint";
import { Theme, Hint, Icon, Caption, FieldLabel, SectionLabel, Divider, Card, Keycap, ActionButton, NavButton, SearchInput, SettingRow, CapabilityCard, ThemeChoice, QuakePreview } from "components.slint";
import { ProjectRow } from "project-types.slint";
import { SkillsPage } from "skills.slint";

export { Palette } from "std-widgets.slint";
export { Theme } from "components.slint";
export { ProjectRow } from "project-types.slint";
export { LauncherWindow } from "launcher.slint";
export { SkillsState, SkillListRow, SkillAppRow, SkillRepositoryRow } from "skills.slint";
export struct ProfileRow { source-index: int, name: string, detail: string, hotkey: string, platform: string, enabled: bool, available: bool, docked: bool }

component ProfileItem inherits Rectangle {
    in property <ProfileRow> item;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    height: 64px;
    border-radius: 6px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    border-width: keys.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: list-item;
    accessible-label: root.item.name + ". " + root.item.detail + ". " + root.item.hotkey;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: keys;
    Rectangle { x: 0px; y: 18px; width: 3px; height: 28px; border-radius: 1px; background: root.selected ? Theme.accent : transparent; }
    VerticalLayout {
        padding-left: 12px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; spacing: 5px;
        HorizontalLayout {
            spacing: 7px;
            Text { text: root.item.name; font-size: 14px; font-weight: root.selected ? 600 : 500; color: root.item.enabled ? Theme.text : Theme.muted; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
            if root.item.hotkey != "": Text { text: root.item.hotkey; color: Theme.secondary; font-size: 11px; min-width: 0px; overflow: elide; max-width: 82px; }
        }
        Text { text: root.item.detail; color: Theme.muted; font-size: 12px; overflow: elide; min-width: 0px; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { keys.focus(); root.clicked(); } }
    keys := FocusScope { enabled: root.enabled; focus-on-click: false; key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; } reject } }
    Tooltip { Hint { text: root.item.name + "\n" + root.item.detail + (root.item.hotkey != "" ? " · " + root.item.hotkey : ""); } }
}

component ShortcutEditor inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <bool> recording;
    in property <bool> starting;
    in property <bool> enabled: true;
    callback edited;
    callback record;
    height: 36px;
    forward-focus: entry;
    HorizontalLayout {
        spacing: 7px;
        entry := LineEdit {
            text <=> root.text;
            height: 36px;
            min-width: 100px;
            enabled: root.enabled && !root.recording && !root.starting;
            placeholder-text: "Ctrl+Alt+T";
            accessible-label: root.label;
            edited => { root.edited(); }
        }
        ActionButton {
            text: root.recording || root.starting ? @tr("ui.shortcut.cancel_recording" => "Cancel") : @tr("ui.shortcut.record" => "Record");
            enabled: root.enabled;
            primary: root.recording;
            clicked => { root.record(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Sean Toolbox";
    icon: @image-url("../../../packaging/sean-toolbox.svg");
    preferred-width: 1120px;
    preferred-height: 780px;
    min-width: 800px;
    min-height: 580px;
    background: Theme.canvas;
    in property <string> platform-font-family;
    default-font-family: root.platform-font-family;
    default-font-size: 14px;
    in-out property <int> page: 0;
    in-out property <bool> loaded: false;
    in-out property <bool> saving: false;
    in-out property <bool> dialog-busy: false;
    in-out property <bool> settings-dirty: false;
    in-out property <string> status-message: @tr("ui.status.connecting" => "Connecting…");
    in-out property <bool> status-error: false;
    in-out property <string> version-label;
    in-out property <[ProjectRow]> projects;
    in-out property <string> query;
    in-out property <int> selected-project: -1;
    in-out property <string> project-message;
    in-out property <bool> project-loading: false;
    in-out property <bool> project-opening: false;
    in-out property <[ProfileRow]> profiles;
    in-out property <string> profile-query;
    in-out property <int> profile-total;
    in-out property <int> selected-profile: -1;
    in-out property <bool> editing: false;
    in-out property <bool> profile-dirty: false;
    in-out property <bool> profile-testable: false;
    in-out property <bool> form-advanced: false;
    in-out property <bool> form-validate: false;
    in-out property <string> profile-error;
    in-out property <string> form-name-error;
    in-out property <string> form-executable-error;
    in-out property <string> form-matcher-error;
    in-out property <string> form-id-error;
    in-out property <string> form-args-error;
    in-out property <string> form-hotkey-error;
    in-out property <int> shortcut-recording: 0;
    in-out property <int> shortcut-pending: 0;
    out property <bool> shortcut-has-focus: keys.has-focus;
    in-out property <string> form-id;
    in-out property <string> form-name;
    in-out property <int> form-platform: 0;
    in-out property <string> form-matcher;
    in-out property <string> form-hotkey;
    in-out property <bool> form-enabled;
    in-out property <bool> form-maximize;
    in-out property <bool> form-cycle;
    in-out property <bool> form-quake-enabled;
    in-out property <bool> form-wezterm-dropdown;
    in-out property <int> form-quake-edge: 0;
    in-out property <int> form-quake-alignment: 1;
    in-out property <int> form-quake-width: 100;
    in-out property <int> form-quake-height: 50;
    in-out property <int> form-quake-monitor: 0;
    in-out property <bool> form-quake-topmost;
    in-out property <bool> form-quake-auto-hide;
    in-out property <[string]> candidate-labels;
    in-out property <int> candidate-index: 0;
    in-out property <string> launch-executable;
    in-out property <string> launch-args: "[]";
    in-out property <string> launch-cwd;
    in-out property <string> profile-help;
    in-out property <int> setting-language: 0;
    in-out property <int> setting-theme: 0;
    in-out property <string> setting-hotkey;
    in-out property <bool> setting-autostart;
    in-out property <bool> setting-projects;
    in-out property <bool> setting-windows;
    in-out property <string> setting-idle: "0";
    in-out property <string> setting-code-path;
    in-out property <string> settings-query;
    in-out property <string> setting-hotkey-error;
    in-out property <string> setting-idle-error;
    in-out property <string> settings-error;
    in-out property <bool> import-visible: false;
    in-out property <bool> import-is-json: false;
    in-out property <string> import-summary;
    in-out property <string> diagnostics;
    in-out property <bool> confirm-visible: false;
    in-out property <string> confirm-title;
    in-out property <string> confirm-message;
    in-out property <string> confirm-accept-label;
    in-out property <string> confirm-cancel-label;
    in-out property <bool> confirm-destructive;
    callback navigate(int);
    callback dismiss;
    callback query-changed(string);
    callback refresh-projects;
    callback open-project(int);
    callback move-project(int);
    callback edit-profile(int);
    callback profile-query-changed(string);
    pure callback text-matches(string, string) -> bool;
    callback start-shortcut(int);
    callback shortcut-focus-lost;
    callback record-shortcut(string, bool, bool, bool, bool);
    callback program-edited;
    callback new-profile;
    callback delete-profile;
    callback save-profile;
    callback cancel-profile;
    callback profile-changed;
    callback toggle-profile(int);
    callback candidate-selected(int);
    callback add-candidate;
    callback remove-candidate;
    callback browse-path(int);
    callback settings-changed;
    callback save-settings;
    callback reload-config;
    callback import-config;
    callback export-config;
    callback apply-import(bool);
    callback cancel-import;
    callback refresh-status;
    callback confirm-action(bool);
    callback open-link(int);

    in-out property <bool> project-error: false;
    in-out property <int> project-total: 0;
    in-out property <bool> projects-enabled: true;
    in-out property <bool> windows-enabled: true;
    in-out property <bool> diagnostic-loaded: false;
    in-out property <bool> diagnostic-loading: false;
    in-out property <bool> diagnostic-window-control: false;
    in-out property <bool> diagnostic-hotkeys: false;
    in-out property <bool> diagnostic-tray: false;
    in-out property <string> diagnostic-backend;
    in-out property <string> diagnostic-platform;
    in-out property <string> diagnostic-last-action;
    in-out property <string> diagnostic-warnings;
    in-out property <string> diagnostic-error;
    private property <bool> diagnostics-expanded: false;
    // Update breakpoints from the observed size, outside the layout bindings.
    // Feeding Window.width into its own minimum-size calculation forms a cycle.
    private property <bool> compact-navigation: false;
    private property <bool> narrow-app-list: false;
    private property <bool> wide-skills-layout: true;
    private property <int> settings-focus-request: 0;
    changed width => {
        root.compact-navigation = root.width < 980px;
        root.narrow-app-list = root.width < 880px;
        root.wide-skills-layout = root.width >= 1100px;
    }
    private property <bool> show-appearance: root.settings-query == "" || root.text-matches(root.settings-query, @tr("ui.settings.search_appearance" => "Appearance theme light dark system"));
    private property <bool> show-general: root.settings-query == "" || root.text-matches(root.settings-query, @tr("ui.settings.search_general" => "General language shortcut sign-in startup cache memory speed"));
    private property <bool> show-tools: root.settings-query == "" || root.text-matches(root.settings-query, @tr("ui.settings.search_tools" => "Tools recent projects window switcher VS Code path"));
    private property <bool> show-configuration: root.settings-query == "" || root.text-matches(root.settings-query, @tr("ui.settings.search_configuration" => "Configuration import export backup reload JSON INI"));
    callback reset-settings;
    private property <bool> blocked: root.confirm-visible || root.import-visible || root.dialog-busy;
    private property <string> page-title: root.page == 0 ? (@tr("ui.navigation.projects" => "Recent projects")) : root.page == 1 ? (@tr("ui.navigation.windows" => "Window switcher")) : root.page == 2 ? (@tr("ui.navigation.settings" => "Settings")) : root.page == 4 ? (@tr("ui.navigation.skills" => "Skills")) : (@tr("ui.navigation.status" => "Status & about"));
    private property <string> page-description: root.page == 0 ? (@tr("ui.page.projects_description" => "Pick up where you left off in VS Code.")) : root.page == 1 ? (@tr("ui.page.windows_description" => "Your everyday apps, one shortcut away.")) : root.page == 2 ? (@tr("ui.page.settings_description" => "Make the toolbox work your way.")) : root.page == 4 ? (@tr("ui.page.skills_description" => "Manage skills across your agents and keep them up to date.")) : (@tr("ui.page.status_description" => "Check what is available on this device."));

    public function focus-page() {
        if root.confirm-visible { confirm-cancel.focus(); }
        else if root.import-visible { import-merge.focus(); }
        else if root.page == 0 { search.focus(); }
        else if root.page == 1 && root.editing { profile-name.focus(); }
        else if root.page == 1 { profile-search.focus(); }
        else if root.page == 2 { settings-search.focus(); }
        else if root.page == 4 { skills-page.focus-search(); }
        else { keys.focus(); }
    }
    public function focus-profile-editor() { profile-name.focus(); }
    public function focus-profile-program() { profile-program.focus(); }
    public function focus-shortcut-recorder() { keys.focus(); }
    public function focus-settings-problem(field: int) {
        root.settings-query = "";
        root.settings-focus-request = field + 1;
    }
    public function focus-profile-problem(field: int) {
        if field >= 3 { root.form-advanced = true; }
        if field == 0 { profile-scroll.content-y = 0px; profile-name.focus(); }
        else if field == 1 { profile-scroll.content-y = 0px; profile-program.focus(); }
        else if field == 2 { profile-scroll.content-y = -profile-shortcut.y; profile-shortcut.focus(); }
        else {
            profile-scroll.content-y = -advanced-toggle.y;
            advanced-toggle.focus();
        }
    }
    public function focus-import-actions() { import-merge.focus(); }
    public function focus-confirm-actions() { confirm-cancel.focus(); }
    public function reveal-selection() {
        if root.selected-project < 0 { return; }
        if root.selected-project * 54px + project-scroll.content-y < 0px {
            project-scroll.content-y = -root.selected-project * 54px;
        }
        if (root.selected-project + 1) * 54px + project-scroll.content-y > project-scroll.visible-height {
            project-scroll.content-y = project-scroll.visible-height - (root.selected-project + 1) * 54px;
        }
    }
    forward-focus: keys;
    keys := FocusScope {
        focus-lost(reason) => {
            // Native activation is checked separately: an X11 shortcut grab
            // briefly deactivates Slint without moving the foreground window.
            if reason != FocusReason.window-activation && (root.shortcut-recording > 0 || root.shortcut-pending > 0) { root.shortcut-focus-lost(); }
        }
        capture-key-pressed(event) => {
            if root.dialog-busy { return accept; }
            if root.shortcut-recording > 0 || root.shortcut-pending > 0 {
                if !keys.has-focus { root.start-shortcut(0); }
                else {
                    if event.text == Key.Escape && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta {
                        root.start-shortcut(0);
                    } else if root.shortcut-recording > 0 {
                        root.record-shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                    }
                    return accept;
                }
            }
            if root.page == 4 && !root.blocked && skills-page.handle-key(event) { return accept; }
            if event.text == Key.Escape { root.dismiss(); return accept; }
            if root.confirm-visible && event.text == Key.Tab {
                if confirm-cancel.has-focus { confirm-continue.focus(); } else { confirm-cancel.focus(); }
                return accept;
            }
            if root.import-visible && event.text == Key.Tab {
                if event.modifiers.shift {
                    if import-cancel.has-focus { import-merge.focus(); }
                    else if import-merge.has-focus { import-replace.focus(); }
                    else { import-cancel.focus(); }
                } else {
                    if import-cancel.has-focus { import-replace.focus(); }
                    else if import-replace.has-focus { import-merge.focus(); }
                    else { import-cancel.focus(); }
                }
                return accept;
            }
            if !root.blocked && (event.modifiers.control || event.modifiers.meta) {
                if event.text == "f" {
                    if root.page == 0 { search.focus(); }
                    else if root.page == 1 { profile-search.focus(); }
                    else if root.page == 2 { settings-search.focus(); }
                    else if root.page == 4 { skills-page.focus-search(); }
                    else { root.diagnostics-expanded = true; diagnostics-details.focus(); }
                    return accept;
                }
                if event.text == "k" { root.navigate(0); search.focus(); return accept; }
                if event.text == "n" && root.page == 1 && root.loaded && !root.saving { root.new-profile(); return accept; }
                if event.text == "s" {
                    if root.loaded && !root.saving {
                        if root.page == 1 && root.editing { root.save-profile(); }
                        else if root.page == 2 && root.settings-dirty { root.save-settings(); }
                    }
                    return accept;
                }
                if event.text == "1" { root.navigate(0); return accept; }
                if event.text == "2" { root.navigate(1); return accept; }
                if event.text == "3" { root.navigate(2); return accept; }
                if event.text == "4" { root.navigate(3); return accept; }
                if event.text == "5" { root.navigate(4); return accept; }
            }
            if root.page == 0 && (search.has-focus || project-keys.has-focus) && !root.blocked {
                if event.text == Key.DownArrow { root.move-project(1); return accept; }
                if event.text == Key.UpArrow { root.move-project(-1); return accept; }
                if event.text == Key.Return { root.open-project(root.selected-project); return accept; }
            }
            reject
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: root.compact-navigation ? 64px : 208px;
                background: Theme.sidebar;
                Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border; }
                VerticalLayout {
                    padding: root.compact-navigation ? 10px : 8px;
                    padding-top: 20px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 44px;
                        padding-left: root.compact-navigation ? 4px : 6px;
                        spacing: 11px;
                        VerticalLayout {
                            width: 28px; alignment: center;
                            Image { height: 28px; source: @image-url("../../../packaging/sean-toolbox.svg"); image-fit: contain; }
                        }
                        VerticalLayout {
                            visible: !root.compact-navigation; alignment: center; spacing: 3px;
                            Text { text: "Sean Toolbox"; font-size: 14px; font-weight: 700; color: Theme.text; }
                            Text { text: root.version-label; font-size: 11px; color: Theme.muted; }
                        }
                    }
                    Rectangle { height: 14px; }
                    SectionLabel { visible: !root.compact-navigation; text: @tr("ui.main.workspace" => "WORKSPACE"); height: 22px; }
                    NavButton { text: @tr("ui.navigation.projects" => "Recent projects"); shortcut: "1"; compact: root.compact-navigation; icon: @image-url("icons/folder.svg"); selected: root.page == 0; clicked => { root.navigate(0); } }
                    NavButton { text: @tr("ui.navigation.windows" => "Window switcher"); shortcut: "2"; compact: root.compact-navigation; icon: @image-url("icons/windows.svg"); selected: root.page == 1; dirty: root.profile-dirty; clicked => { root.navigate(1); } }
                    NavButton { text: @tr("ui.navigation.skills" => "Skills"); shortcut: "5"; compact: root.compact-navigation; icon: @image-url("icons/code.svg"); selected: root.page == 4; clicked => { root.navigate(4); } }
                    Rectangle { vertical-stretch: 1; }
                    SectionLabel { visible: !root.compact-navigation; text: @tr("ui.main.preferences" => "PREFERENCES"); height: 22px; }
                    NavButton { text: @tr("ui.navigation.settings" => "Settings"); shortcut: "3"; compact: root.compact-navigation; icon: @image-url("icons/settings.svg"); selected: root.page == 2; dirty: root.settings-dirty; clicked => { root.navigate(2); } }
                    NavButton { text: @tr("ui.navigation.status" => "Status & about"); shortcut: "4"; compact: root.compact-navigation; icon: @image-url("icons/activity.svg"); selected: root.page == 3; clicked => { root.navigate(3); } }
                    Caption { visible: !root.compact-navigation; text: @tr("ui.navigation.shortcut_hint" => "Ctrl / ⌘ + number"); font-size: 11px; }
                    Rectangle { height: 10px; }
                    Divider {}
                    HorizontalLayout {
                        height: 42px; spacing: 8px; padding-left: 5px;
                        VerticalLayout { width: 6px; alignment: center; Rectangle { height: 6px; border-radius: 3px; background: root.loaded ? Theme.success : Theme.muted; } }
                        Text { visible: !root.compact-navigation; text: @tr("ui.main.on_your_device" => "On your device"); color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding-left: root.compact-navigation ? 18px : 24px;
                    padding-right: root.compact-navigation ? 18px : 24px;
                    padding-top: 20px;
                    padding-bottom: 14px;
                    spacing: 14px;
                    HorizontalLayout {
                        height: 42px;
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 7px;
                            horizontal-stretch: 1;
                            Text { text: root.page-title; color: Theme.text; font-size: 22px; font-weight: 650; }
                        }
                        ActionButton { text: @tr("ui.main.close_ui_esc" => "Close UI · Esc"); subtle: true; icon: @image-url("icons/close.svg"); with-icon: true; clicked => { root.dismiss(); } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 0px;
                        min-width: 0px;
                        // Mounted pages preserve independent application and settings drafts.
                        VerticalLayout {
                            visible: root.page == 0;
                            spacing: 16px;
                            search := SearchInput {
                                text <=> root.query;
                                enabled: root.loaded && root.projects-enabled;
                                placeholder-text: @tr("ui.main.search_projects_by_name_or_path" => "Search projects by name or path…");
                                clear-label: @tr("ui.action.clear_search" => "Clear search");
                                edited(text) => { root.query-changed(text); }
                            }
                            Card {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 0px;
                                    HorizontalLayout {
                                        height: 40px; padding-left: 12px; padding-right: 5px; spacing: 10px;
                                        SectionLabel { text: root.query == "" ? (@tr("ui.main.recently_opened" => "RECENTLY OPENED")) : (@tr("ui.main.search_results" => "SEARCH RESULTS")); }
                                        Text { text: root.projects.length > 0 ? root.projects.length : ""; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        ActionButton { text: @tr("ui.action.refresh" => "Refresh"); with-icon: true; icon: @image-url("icons/refresh.svg"); subtle: true; enabled: root.loaded && !root.project-loading && root.projects-enabled; clicked => { root.refresh-projects(); } }
                                    }
                                    Divider {}
                                    Rectangle {
                                        vertical-stretch: 1;
                                        project-scroll := ScrollView {
                                            visible: root.projects.length > 0;
                                            horizontal-scrollbar-policy: always-off;
                                            VerticalLayout {
                                                spacing: 0px;
                                                for item[index] in root.projects: Rectangle {
                                                    height: 54px;
                                                    border-radius: 6px;
                                                    background: index == root.selected-project ? Theme.accent-soft : project-touch.has-hover ? Theme.hover : transparent;
                                                    Rectangle { x: 0px; width: 3px; height: 26px; y: 14px; border-radius: 1.5px; background: index == root.selected-project ? Theme.accent : transparent; }
                                                    accessible-role: button;
                                                    accessible-label: item.name + " " + item.location;
                                                    accessible-action-default => { root.open-project(index); }
                                                    HorizontalLayout {
                                                        padding-left: 12px; padding-right: 14px; spacing: 12px;
                                                        VerticalLayout {
                                                            width: 24px; alignment: center;
                                                            Rectangle {
                                                                height: 24px;
                                                                Icon { x: 2px; y: 2px; height: 20px; source: @image-url("icons/folder.svg"); colorize: index == root.selected-project ? Theme.accent : Theme.muted; }
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                            Text { text: item.name; color: Theme.text; font-size: 14px; font-weight: index == root.selected-project ? 600 : 500; overflow: elide; min-width: 0px; }
                                                            Text { text: item.display-location; color: Theme.muted; font-size: 12px; overflow: elide; min-width: 0px; }
                                                        }
                                                        Text { text: item.source; font-size: 11px; color: Theme.muted; width: 48px; vertical-alignment: center; }
                                                        Icon { width: 15px; source: @image-url("icons/arrow-right.svg"); colorize: index == root.selected-project ? Theme.accent : Theme.disabled; }
                                                    }
                                                    project-touch := TouchArea {
                                                        enabled: !root.project-opening && !root.project-loading;
                                                        mouse-cursor: pointer;
                                                        clicked => { root.selected-project = index; project-keys.focus(); }
                                                        double-clicked => { root.open-project(index); }
                                                    }
                                                    Tooltip { Hint { text: item.name + "\n" + item.location; } }
                                                }
                                                Rectangle { min-height: 0px; vertical-stretch: 1; }
                                            }
                                        }
                                        project-keys := FocusScope {
                                            enabled: root.page == 0 && root.projects.length > 0 && !root.blocked;
                                            focus-on-click: false;
                                        }
                                        if root.projects.length == 0: VerticalLayout {
                                            padding: 28px;
                                            alignment: center;
                                            spacing: 15px;
                                            HorizontalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 64px; height: 64px; border-radius: 18px;
                                                    background: root.project-error ? Theme.warning-soft : Theme.accent-soft;
                                                    Icon { width: 30px; height: 30px; x: 17px; y: 17px; source: root.project-error ? @image-url("icons/warning.svg") : @image-url("icons/folder.svg"); colorize: root.project-error ? Theme.warning : Theme.accent; }
                                                }
                                            }
                                            Text {
                                                text: !root.loaded ? (@tr("ui.main.connecting_to_your_toolbox" => "Connecting to your toolbox")) : root.project-loading ? (@tr("ui.main.loading_your_projects" => "Loading your projects")) : !root.projects-enabled ? (@tr("ui.projects.disabled" => "Recent projects is turned off")) : root.project-error ? (@tr("ui.projects.read_failed" => "Couldn't read recent projects")) : root.query != "" ? (@tr("ui.projects.no_matches" => "No matching projects")) : (@tr("ui.main.your_next_project_starts_here" => "Your next project starts here"));
                                                font-size: 18px; font-weight: 600; color: Theme.text; horizontal-alignment: center;
                                            }
                                            Caption {
                                                text: root.project-error ? root.project-message : !root.projects-enabled ? (@tr("ui.projects.enable_hint" => "Enable recent projects in Settings to get started.")) : root.query != "" ? (@tr("ui.projects.search_hint" => "Try a shorter name or part of a project path.")) : (@tr("ui.projects.empty_hint" => "Open a folder or workspace in VS Code, then refresh this list."));
                                                horizontal-alignment: center;
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                ActionButton {
                                                    text: !root.projects-enabled ? (@tr("ui.action.open_settings" => "Open settings")) : root.query != "" ? (@tr("ui.action.clear_search" => "Clear search")) : (@tr("ui.action.refresh_projects" => "Refresh projects"));
                                                    enabled: root.loaded && !root.project-loading;
                                                    primary: true;
                                                    clicked => {
                                                        if !root.projects-enabled { root.navigate(2); }
                                                        else if root.query != "" { root.query = ""; root.query-changed(""); search.focus(); }
                                                        else { root.refresh-projects(); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Divider {}
                                    HorizontalLayout {
                                        height: 48px; padding-left: 14px; padding-right: 12px; spacing: 8px;
                                        Icon { source: @image-url("icons/code.svg"); width: 15px; }
                                        Caption { text: root.project-loading ? (@tr("ui.main.updating" => "Updating…")) : root.projects.length > 0 ? root.project-message : (@tr("ui.main.vs_code_history_stored_locally" => "VS Code history · stored locally")); horizontal-stretch: 1; }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 40px; spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Keycap { text: "↑ ↓"; }
                                        Caption { text: @tr("ui.action.select" => "Select"); }
                                        Keycap { text: "Enter"; }
                                        Caption { text: @tr("ui.action.open" => "Open"); }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton {
                                    text: root.project-opening ? (@tr("ui.main.opening" => "Opening…")) : (@tr("ui.main.open_in_vs_code" => "Open in VS Code"));
                                    icon: @image-url("icons/arrow-right.svg"); with-icon: true; primary: true;
                                    enabled: root.selected-project >= 0 && !root.project-opening && !root.project-loading && root.projects-enabled;
                                    clicked => { root.open-project(root.selected-project); }
                                }
                            }
                        }
                        VerticalLayout {
                            visible: root.page == 1;
                            spacing: 12px;
                            if !root.windows-enabled: Card {
                                height: 42px; background: Theme.warning-soft;
                                HorizontalLayout {
                                    padding: 8px; spacing: 8px;
                                    Caption { text: @tr("ui.profiles.disabled_hint" => "Window switching is turned off. Your app configurations are kept."); color: Theme.warning; horizontal-stretch: 1; }
                                    ActionButton { text: @tr("ui.action.open_settings" => "Open settings"); subtle: true; clicked => { root.navigate(2); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    width: root.narrow-app-list ? 184px : 210px;
                                    spacing: 10px;
                                    ActionButton { text: @tr("ui.main.add_application" => "Add application"); with-icon: true; icon: @image-url("icons/plus.svg"); primary: true; enabled: root.loaded && !root.saving; clicked => { root.new-profile(); } }
                                    profile-search := SearchInput {
                                        height: 38px;
                                        text <=> root.profile-query;
                                        placeholder-text: @tr("ui.profiles.search" => "Find an app…");
                                        clear-label: @tr("ui.action.clear_search" => "Clear search");
                                        edited(query) => { root.profile-query-changed(query); }
                                    }
                                    HorizontalLayout {
                                        height: 18px; spacing: 8px;
                                        SectionLabel { text: @tr("ui.main.applications" => "APPLICATIONS"); }
                                        Text { text: root.profiles.length + (root.profile-query != "" ? " / " + root.profile-total : ""); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    ScrollView {
