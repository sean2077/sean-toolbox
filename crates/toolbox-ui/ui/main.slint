import { CheckBox, ComboBox, LineEdit, ScrollView, TextEdit, AboutSlint, Switch, Spinner, SpinBox } from "std-widgets.slint";
import { Theme, Icon, Caption, FieldLabel, SectionLabel, Divider, Card, Keycap, ActionButton, NavButton, SearchInput, SettingRow, CapabilityCard, ThemeChoice, QuakePreview } from "components.slint";
import { ProjectRow } from "project-types.slint";
import { SkillsPage } from "skills.slint";

export { Palette } from "std-widgets.slint";
export { Theme } from "components.slint";
export { ProjectRow } from "project-types.slint";
export { LauncherWindow } from "launcher.slint";
export { SkillsState, SkillListRow, SkillAppRow, SkillRepositoryRow } from "skills.slint";
export struct ProfileRow { name: string, detail: string, hotkey: string, platform: string, enabled: bool, available: bool }

export component AppWindow inherits Window {
    title: "Sean Toolbox";
    icon: @image-url("../../../packaging/sean-toolbox.svg");
    preferred-width: 1120px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 650px;
    background: Theme.canvas;
    in property <string> platform-font-family;
    default-font-family: root.platform-font-family;
    default-font-size: 14px;
    in-out property <int> page: 0;
    in-out property <bool> loaded: false;
    in-out property <bool> saving: false;
    in-out property <bool> dialog-busy: false;
    in-out property <bool> settings-dirty: false;
    in-out property <string> status-message: @tr("ui.status.connecting" => "Connecting…");
    in-out property <bool> status-error: false;
    in-out property <string> version-label;
    in-out property <[ProjectRow]> projects;
    in-out property <string> query;
    in-out property <int> selected-project: -1;
    in-out property <string> project-message;
    in-out property <bool> project-loading: false;
    in-out property <bool> project-opening: false;
    in-out property <[ProfileRow]> profiles;
    in-out property <int> selected-profile: -1;
    in-out property <bool> editing: false;
    in-out property <bool> profile-dirty: false;
    in-out property <string> form-id;
    in-out property <string> form-name;
    in-out property <int> form-platform: 0;
    in-out property <string> form-matcher;
    in-out property <string> form-hotkey;
    in-out property <bool> form-enabled;
    in-out property <bool> form-maximize;
    in-out property <bool> form-cycle;
    in-out property <bool> form-quake-enabled;
    in-out property <bool> form-wezterm-dropdown;
    in-out property <int> form-quake-edge: 0;
    in-out property <int> form-quake-alignment: 1;
    in-out property <int> form-quake-width: 100;
    in-out property <int> form-quake-height: 50;
    in-out property <int> form-quake-monitor: 0;
    in-out property <bool> form-quake-topmost;
    in-out property <bool> form-quake-auto-hide;
    in-out property <[string]> candidate-labels;
    in-out property <int> candidate-index: 0;
    in-out property <string> launch-executable;
    in-out property <string> launch-args: "[]";
    in-out property <string> launch-cwd;
    in-out property <string> profile-help;
    in-out property <int> setting-language: 0;
    in-out property <int> setting-theme: 0;
    in-out property <string> setting-hotkey;
    in-out property <bool> setting-autostart;
    in-out property <bool> setting-projects;
    in-out property <bool> setting-windows;
    in-out property <string> setting-idle: "0";
    in-out property <string> setting-code-path;
    in-out property <bool> import-visible: false;
    in-out property <bool> import-is-json: false;
    in-out property <string> import-summary;
    in-out property <string> diagnostics;
    in-out property <bool> confirm-visible: false;
    in-out property <string> confirm-title;
    in-out property <string> confirm-message;
    callback navigate(int);
    callback dismiss;
    callback query-changed(string);
    callback refresh-projects;
    callback open-project(int);
    callback move-project(int);
    callback edit-profile(int);
    callback new-profile;
    callback delete-profile;
    callback save-profile;
    callback cancel-profile;
    callback profile-changed;
    callback toggle-profile(int);
    callback candidate-selected(int);
    callback add-candidate;
    callback remove-candidate;
    callback browse-path(int);
    callback settings-changed;
    callback save-settings;
    callback reload-config;
    callback import-config;
    callback export-config;
    callback apply-import(bool);
    callback cancel-import;
    callback refresh-status;
    callback confirm-action(bool);
    callback open-link(int);

    in-out property <bool> project-error: false;
    in-out property <int> project-total: 0;
    in-out property <bool> projects-enabled: true;
    in-out property <bool> windows-enabled: true;
    in-out property <bool> diagnostic-loaded: false;
    in-out property <bool> diagnostic-loading: false;
    in-out property <bool> diagnostic-window-control: false;
    in-out property <bool> diagnostic-hotkeys: false;
    in-out property <bool> diagnostic-tray: false;
    in-out property <string> diagnostic-backend;
    in-out property <string> diagnostic-platform;
    in-out property <string> diagnostic-last-action;
    in-out property <string> diagnostic-warnings;
    in-out property <string> diagnostic-error;
    private property <bool> diagnostics-expanded: false;
    callback reset-settings;
    private property <bool> blocked: root.confirm-visible || root.import-visible || root.dialog-busy;
    private property <string> page-title: root.page == 0 ? (@tr("ui.navigation.projects" => "Recent projects")) : root.page == 1 ? (@tr("ui.navigation.windows" => "Window switcher")) : root.page == 2 ? (@tr("ui.navigation.settings" => "Settings")) : root.page == 4 ? (@tr("ui.navigation.skills" => "Skills")) : (@tr("ui.navigation.status" => "Status & about"));
    private property <string> page-description: root.page == 0 ? (@tr("ui.page.projects_description" => "Pick up where you left off in VS Code.")) : root.page == 1 ? (@tr("ui.page.windows_description" => "Your everyday apps, one shortcut away.")) : root.page == 2 ? (@tr("ui.page.settings_description" => "Make the toolbox work your way.")) : root.page == 4 ? (@tr("ui.page.skills_description" => "Manage skills across your agents and keep them up to date.")) : (@tr("ui.page.status_description" => "Check what is available on this device."));

    public function focus-page() {
        if root.confirm-visible { confirm-cancel.focus(); }
        else if root.import-visible { import-merge.focus(); }
        else if root.page == 0 { search.focus(); }
        else if root.page == 1 && root.editing { profile-name.focus(); }
        else if root.page == 4 { skills-page.focus-search(); }
        else { keys.focus(); }
    }
    public function focus-profile-editor() { profile-name.focus(); }
    public function focus-import-actions() { import-merge.focus(); }
    public function focus-confirm-actions() { confirm-cancel.focus(); }
    public function reveal-selection() {
        if root.selected-project < 0 { return; }
        if root.selected-project * 72px + project-scroll.content-y < 0px {
            project-scroll.content-y = -root.selected-project * 72px;
        }
        if (root.selected-project + 1) * 72px + project-scroll.content-y > project-scroll.visible-height {
            project-scroll.content-y = project-scroll.visible-height - (root.selected-project + 1) * 72px;
        }
    }
    forward-focus: keys;
    keys := FocusScope {
        capture-key-pressed(event) => {
            if root.dialog-busy { return accept; }
            if event.text == Key.Escape { root.dismiss(); return accept; }
            if root.confirm-visible && event.text == Key.Tab {
                if confirm-cancel.has-focus { confirm-continue.focus(); } else { confirm-cancel.focus(); }
                return accept;
            }
            if root.import-visible && event.text == Key.Tab {
                if event.modifiers.shift {
                    if import-cancel.has-focus { import-merge.focus(); }
                    else if import-merge.has-focus { import-replace.focus(); }
                    else { import-cancel.focus(); }
                } else {
                    if import-cancel.has-focus { import-replace.focus(); }
                    else if import-replace.has-focus { import-merge.focus(); }
                    else { import-cancel.focus(); }
                }
                return accept;
            }
            if !root.blocked && (event.modifiers.control || event.modifiers.meta) {
                if event.text == "f" && root.page == 4 { skills-page.focus-search(); return accept; }
                if event.text == "k" || event.text == "f" { root.navigate(0); search.focus(); return accept; }
                if event.text == "s" {
                    if root.loaded && !root.saving {
                        if root.page == 1 && root.editing { root.save-profile(); }
                        else if root.page == 2 && root.settings-dirty { root.save-settings(); }
                    }
                    return accept;
                }
                if event.text == "1" { root.navigate(0); return accept; }
                if event.text == "2" { root.navigate(1); return accept; }
                if event.text == "3" { root.navigate(2); return accept; }
                if event.text == "4" { root.navigate(3); return accept; }
                if event.text == "5" { root.navigate(4); return accept; }
            }
            if root.page == 0 && (search.has-focus || project-keys.has-focus) && !root.blocked {
                if event.text == Key.DownArrow { root.move-project(1); return accept; }
                if event.text == Key.UpArrow { root.move-project(-1); return accept; }
                if event.text == Key.Return { root.open-project(root.selected-project); return accept; }
            }
            reject
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 202px;
                background: Theme.sidebar;
                Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border; }
                VerticalLayout {
                    padding: 16px;
                    padding-top: 28px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 44px;
                        padding-left: 7px;
                        spacing: 11px;
                        VerticalLayout {
                            width: 36px; alignment: center;
                            Image { height: 36px; source: @image-url("../../../packaging/sean-toolbox.svg"); image-fit: contain; }
                        }
                        VerticalLayout {
                            alignment: center; spacing: 3px;
                            Text { text: "Sean Toolbox"; font-size: 14px; font-weight: 700; color: Theme.text; }
                            Text { text: @tr("ui.main.personal_workspace" => "Personal workspace"); font-size: 11px; color: Theme.muted; }
                        }
                    }
                    Rectangle { height: 25px; }
                    SectionLabel { text: @tr("ui.main.workspace" => "WORKSPACE"); height: 24px; }
                    NavButton { text: @tr("ui.navigation.projects" => "Recent projects"); icon: @image-url("icons/folder.svg"); selected: root.page == 0; clicked => { root.navigate(0); } }
                    NavButton { text: @tr("ui.navigation.windows" => "Window switcher"); icon: @image-url("icons/windows.svg"); selected: root.page == 1; dirty: root.profile-dirty; clicked => { root.navigate(1); } }
                    NavButton { text: @tr("ui.navigation.skills" => "Skills"); icon: @image-url("icons/code.svg"); selected: root.page == 4; clicked => { root.navigate(4); } }
                    Rectangle { vertical-stretch: 1; }
                    SectionLabel { text: @tr("ui.main.preferences" => "PREFERENCES"); height: 24px; }
                    NavButton { text: @tr("ui.navigation.settings" => "Settings"); icon: @image-url("icons/settings.svg"); selected: root.page == 2; dirty: root.settings-dirty; clicked => { root.navigate(2); } }
                    NavButton { text: @tr("ui.navigation.status" => "Status & about"); icon: @image-url("icons/activity.svg"); selected: root.page == 3; clicked => { root.navigate(3); } }
                    Rectangle { height: 10px; }
                    Divider {}
                    HorizontalLayout {
                        height: 42px; spacing: 8px; padding-left: 5px;
                        VerticalLayout { width: 6px; alignment: center; Rectangle { height: 6px; border-radius: 3px; background: root.loaded ? Theme.success : Theme.muted; } }
                        Text { text: @tr("ui.main.on_your_device" => "On your device"); color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                        Text { text: root.version-label; color: Theme.muted; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding-left: 30px;
                    padding-right: 30px;
                    padding-top: 28px;
                    padding-bottom: 14px;
                    spacing: 20px;
                    HorizontalLayout {
                        height: root.page == 4 ? 48px : 63px;
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 7px;
                            horizontal-stretch: 1;
                            Text { text: root.page-title; color: Theme.text; font-size: 26px; font-weight: 700; }
                            Caption { visible: root.page != 4; text: root.page-description; font-size: 13px; }
                        }
                        ActionButton { text: @tr("ui.main.close_ui_esc" => "Close UI · Esc"); subtle: true; icon: @image-url("icons/close.svg"); with-icon: true; clicked => { root.dismiss(); } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        // Mounted pages preserve independent application and settings drafts.
                        VerticalLayout {
                            visible: root.page == 0;
                            spacing: 16px;
                            search := SearchInput {
                                text <=> root.query;
                                enabled: root.loaded && root.projects-enabled;
                                placeholder-text: @tr("ui.main.search_projects_by_name_or_path" => "Search projects by name or path…");
                                clear-label: @tr("ui.action.clear_search" => "Clear search");
                                edited(text) => { root.query-changed(text); }
                            }
                            Card {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 0px;
                                    HorizontalLayout {
                                        height: 48px; padding-left: 12px; padding-right: 5px; spacing: 10px;
                                        SectionLabel { text: root.query == "" ? (@tr("ui.main.recently_opened" => "RECENTLY OPENED")) : (@tr("ui.main.search_results" => "SEARCH RESULTS")); }
                                        Text { text: root.projects.length > 0 ? root.projects.length : ""; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        ActionButton { text: @tr("ui.action.refresh" => "Refresh"); with-icon: true; icon: @image-url("icons/refresh.svg"); subtle: true; enabled: root.loaded && !root.project-loading && root.projects-enabled; clicked => { root.refresh-projects(); } }
                                    }
                                    Divider {}
                                    Rectangle {
                                        vertical-stretch: 1;
                                        project-scroll := ScrollView {
                                            visible: root.projects.length > 0;
                                            horizontal-scrollbar-policy: always-off;
                                            VerticalLayout {
                                                spacing: 0px;
                                                for item[index] in root.projects: Rectangle {
                                                    height: 72px;
                                                    border-radius: 7px;
                                                    background: index == root.selected-project ? Theme.accent-soft : project-touch.has-hover ? Theme.hover : transparent;
                                                    Rectangle { x: 0px; width: 3px; height: 28px; y: 22px; border-radius: 1.5px; background: index == root.selected-project ? Theme.accent : transparent; }
                                                    accessible-role: button;
                                                    accessible-label: item.name + " " + item.location;
                                                    accessible-action-default => { root.open-project(index); }
                                                    HorizontalLayout {
                                                        padding-left: 16px; padding-right: 17px; spacing: 14px;
                                                        VerticalLayout {
                                                            width: 38px; alignment: center;
                                                            Rectangle {
                                                                height: 38px; border-radius: 9px;
                                                                background: index == root.selected-project ? Theme.selection : Theme.raised;
                                                                Icon { x: 9px; y: 9px; height: 20px; source: @image-url("icons/folder.svg"); colorize: index == root.selected-project ? Theme.accent : Theme.muted; }
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center; spacing: 5px; horizontal-stretch: 1;
                                                            Text { text: item.name; color: Theme.text; font-size: 14px; font-weight: index == root.selected-project ? 600 : 500; overflow: elide; min-width: 0px; }
                                                            Text { text: item.location; color: Theme.muted; font-size: 11px; overflow: elide; min-width: 0px; }
                                                        }
                                                        Text { text: item.source; font-size: 10px; color: Theme.muted; width: 48px; vertical-alignment: center; }
                                                        Icon { width: 15px; source: @image-url("icons/arrow-right.svg"); colorize: index == root.selected-project ? Theme.accent : Theme.disabled; }
                                                    }
                                                    project-touch := TouchArea {
                                                        enabled: !root.project-opening && !root.project-loading;
                                                        mouse-cursor: pointer;
                                                        clicked => { root.selected-project = index; project-keys.focus(); }
                                                        double-clicked => { root.open-project(index); }
                                                    }
                                                }
                                                Rectangle { min-height: 0px; vertical-stretch: 1; }
                                            }
                                        }
                                        project-keys := FocusScope {
                                            enabled: root.page == 0 && root.projects.length > 0 && !root.blocked;
                                            focus-on-click: false;
                                        }
                                        if root.projects.length == 0: VerticalLayout {
                                            padding: 28px;
                                            alignment: center;
                                            spacing: 15px;
                                            HorizontalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 64px; height: 64px; border-radius: 18px;
                                                    background: root.project-error ? Theme.warning-soft : Theme.accent-soft;
                                                    Icon { width: 30px; height: 30px; x: 17px; y: 17px; source: root.project-error ? @image-url("icons/warning.svg") : @image-url("icons/folder.svg"); colorize: root.project-error ? Theme.warning : Theme.accent; }
                                                }
                                            }
                                            Text {
                                                text: !root.loaded ? (@tr("ui.main.connecting_to_your_toolbox" => "Connecting to your toolbox")) : root.project-loading ? (@tr("ui.main.loading_your_projects" => "Loading your projects")) : !root.projects-enabled ? (@tr("ui.projects.disabled" => "Recent projects is turned off")) : root.project-error ? (@tr("ui.projects.read_failed" => "Couldn't read recent projects")) : root.query != "" ? (@tr("ui.projects.no_matches" => "No matching projects")) : (@tr("ui.main.your_next_project_starts_here" => "Your next project starts here"));
                                                font-size: 18px; font-weight: 600; color: Theme.text; horizontal-alignment: center;
                                            }
                                            Caption {
                                                text: root.project-error ? root.project-message : !root.projects-enabled ? (@tr("ui.projects.enable_hint" => "Enable recent projects in Settings to get started.")) : root.query != "" ? (@tr("ui.projects.search_hint" => "Try a shorter name or part of a project path.")) : (@tr("ui.projects.empty_hint" => "Open a folder or workspace in VS Code, then refresh this list."));
                                                horizontal-alignment: center;
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                ActionButton {
                                                    text: !root.projects-enabled ? (@tr("ui.action.open_settings" => "Open settings")) : root.query != "" ? (@tr("ui.action.clear_search" => "Clear search")) : (@tr("ui.action.refresh_projects" => "Refresh projects"));
                                                    enabled: root.loaded && !root.project-loading;
                                                    primary: true;
                                                    clicked => {
                                                        if !root.projects-enabled { root.navigate(2); }
                                                        else if root.query != "" { root.query = ""; root.query-changed(""); search.focus(); }
                                                        else { root.refresh-projects(); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Divider {}
                                    HorizontalLayout {
                                        height: 48px; padding-left: 14px; padding-right: 12px; spacing: 8px;
                                        Icon { source: @image-url("icons/code.svg"); width: 15px; }
                                        Caption { text: root.project-loading ? (@tr("ui.main.updating" => "Updating…")) : root.projects.length > 0 ? root.project-message : (@tr("ui.main.vs_code_history_stored_locally" => "VS Code history · stored locally")); horizontal-stretch: 1; }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 40px; spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Keycap { text: "↑ ↓"; }
                                        Caption { text: @tr("ui.action.select" => "Select"); }
                                        Keycap { text: "Enter"; }
                                        Caption { text: @tr("ui.action.open" => "Open"); }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton {
                                    text: root.project-opening ? (@tr("ui.main.opening" => "Opening…")) : (@tr("ui.main.open_in_vs_code" => "Open in VS Code"));
                                    icon: @image-url("icons/arrow-right.svg"); with-icon: true; primary: true;
                                    enabled: root.selected-project >= 0 && !root.project-opening && !root.project-loading && root.projects-enabled;
                                    clicked => { root.open-project(root.selected-project); }
                                }
                            }
                        }
                        VerticalLayout {
                            visible: root.page == 1;
                            spacing: 14px;
                            if !root.windows-enabled: Card {
                                height: 46px; background: Theme.warning-soft;
                                HorizontalLayout {
                                    padding: 12px; spacing: 10px;
                                    Icon { source: @image-url("icons/info.svg"); colorize: Theme.warning; width: 17px; }
                                    Caption { text: @tr("ui.profiles.disabled_hint" => "Window switching is turned off. Your app configurations are kept."); color: Theme.warning; horizontal-stretch: 1; }
                                    ActionButton { text: @tr("ui.action.open_settings" => "Open settings"); subtle: true; clicked => { root.navigate(2); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 18px;
                                VerticalLayout {
                                    width: 208px;
                                    spacing: 12px;
                                    ActionButton { text: @tr("ui.main.add_application" => "Add application"); with-icon: true; icon: @image-url("icons/plus.svg"); primary: true; enabled: root.loaded && !root.saving; clicked => { root.new-profile(); } }
                                    HorizontalLayout {
                                        height: 20px; spacing: 8px;
                                        SectionLabel { text: @tr("ui.main.applications" => "APPLICATIONS"); }
                                        Text { text: root.profiles.length; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    ScrollView {
                                        horizontal-scrollbar-policy: always-off;
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            spacing: 8px;
                                            for item[index] in root.profiles: Card {
                                                height: 110px;
                                                border-color: root.selected-profile == index ? Theme.accent-border : Theme.border;
                                                background: root.selected-profile == index ? Theme.accent-soft : Theme.surface;
                                                VerticalLayout {
                                                    padding: 13px; spacing: 8px;
                                                    HorizontalLayout {
                                                        spacing: 9px;
                                                        Icon { source: @image-url("icons/windows.svg"); width: 17px; colorize: root.selected-profile == index ? Theme.accent : Theme.muted; }
                                                        Text { text: item.name; color: item.enabled ? Theme.text : Theme.muted; font-weight: 600; font-size: 13px; horizontal-stretch: 1; overflow: elide; min-width: 0px; }
                                                        VerticalLayout { width: 6px; alignment: center; Rectangle { height: 6px; border-radius: 3px; background: item.enabled && item.available ? Theme.success : Theme.disabled; } }
                                                    }
                                                    HorizontalLayout {
                                                        Text { text: item.available ? item.platform : @tr("ui.profiles.other_platform" => "{0} · other OS", item.platform); font-size: 10px; color: Theme.muted; horizontal-stretch: 1; }
                                                        Text { text: item.hotkey; color: item.available ? Theme.accent : Theme.muted; font-size: 11px; font-weight: 600; }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        ActionButton { text: @tr("ui.action.edit" => "Edit"); height: 28px; enabled: !root.saving; clicked => { root.edit-profile(index); } }
                                                        ActionButton { text: @tr("ui.action.switch" => "Switch"); height: 28px; subtle: true; enabled: root.loaded && item.enabled && item.available && root.windows-enabled && !root.saving; clicked => { root.toggle-profile(index); } }
                                                    }
                                                }
                                            }
                                            if root.profiles.length == 0: Caption { text: @tr("ui.profiles.empty_hint" => "No applications yet. Add one to create your first shortcut."); }
                                            Rectangle { min-height: 0px; vertical-stretch: 1; }
                                        }
                                    }
                                }
                                Card {
                                    horizontal-stretch: 1;
                                    if !root.editing: VerticalLayout {
                                        padding: 28px; alignment: center; spacing: 16px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle { width: 64px; height: 64px; border-radius: 18px; background: Theme.accent-soft; Icon { x: 17px; y: 17px; width: 30px; height: 30px; source: @image-url("icons/keyboard.svg"); colorize: Theme.accent; } }
                                        }
                                        Text { text: @tr("ui.profiles.introduction" => "Less searching. More doing."); font-size: 19px; font-weight: 600; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                                        Caption { text: @tr("ui.profiles.edit_hint" => "Edit an app to set its shortcut and launch options, or add a new one."); horizontal-alignment: center; }
                                        Divider {}
                                        Caption { text: @tr("ui.profiles.switch_hint" => "One window: focus or minimize.\nMultiple windows: cycle in the selected mode.\nNot running: launch the app."); horizontal-alignment: center; }
                                    }
                                    VerticalLayout {
                                        visible: root.editing;
                                        padding: 18px;
                                        spacing: 14px;
                                        HorizontalLayout {
                                            height: 28px;
                                            Text { text: root.selected-profile < 0 ? (@tr("ui.main.new_application" => "New application")) : root.form-name; color: Theme.text; font-size: 17px; font-weight: 600; horizontal-stretch: 1; overflow: elide; min-width: 0px; }
                                            Caption { text: root.profile-dirty ? (@tr("ui.main.unsaved" => "Unsaved")) : (@tr("ui.main.saved" => "Saved")); color: root.profile-dirty ? Theme.warning : Theme.muted; }
                                        }
                                        Divider {}
                                        ScrollView {
                                            horizontal-scrollbar-policy: always-off;
                                            content-width: self.visible-width;
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                padding-right: 8px;
                                                spacing: 10px;
                                                SectionLabel { text: @tr("ui.main.application" => "APPLICATION"); height: 20px; }
                                                FieldLabel { text: @tr("ui.main.display_name" => "Display name"); }
                                                profile-name := LineEdit { height: 36px; text <=> root.form-name; placeholder-text: @tr("ui.main.e_g_vs_code" => "e.g. VS Code"); enabled: !root.saving; edited => { root.profile-changed(); } }
                                                HorizontalLayout {
                                                    spacing: 10px;
                                                    VerticalLayout {
                                                        spacing: 6px;
                                                        FieldLabel { text: @tr("ui.main.application_id" => "Application ID"); }
                                                        LineEdit { height: 34px; min-width: 100px; text <=> root.form-id; placeholder-text: "my-app"; enabled: !root.saving; edited => { root.profile-changed(); } }
                                                    }
                                                    VerticalLayout {
                                                        width: 112px; spacing: 6px;
                                                        FieldLabel { text: @tr("ui.main.platform" => "Platform"); }
                                                        ComboBox { height: 34px; min-width: 100px; model: ["Windows", "macOS", "Linux"]; current-index <=> root.form-platform; enabled: !root.saving; selected => { root.profile-changed(); } }
                                                    }
                                                }
                                                FieldLabel { text: @tr("ui.main.window_match" => "Window match"); }
                                                LineEdit { height: 34px; text <=> root.form-matcher; placeholder-text: root.form-platform == 0 ? "Code.exe" : root.form-platform == 1 ? "com.microsoft.VSCode" : "Code"; enabled: !root.saving; edited => { root.profile-changed(); } }
                                                Caption { text: root.profile-help; font-size: 11px; }
                                                FieldLabel { text: @tr("ui.main.shortcut_optional" => "Shortcut · optional"); }
                                                LineEdit { height: 34px; text <=> root.form-hotkey; placeholder-text: "F3 / Ctrl+Alt+T"; enabled: !root.saving; edited => { root.profile-changed(); } }
                                                CheckBox { text: @tr("ui.main.enable_this_application" => "Enable this application"); checked <=> root.form-enabled; enabled: !root.saving; toggled => { root.profile-changed(); } }
                                                if !root.form-quake-enabled: CheckBox { text: @tr("ui.profiles.maximize_new" => "Maximize newly launched windows only"); checked <=> root.form-maximize; enabled: !root.saving; toggled => { root.profile-changed(); } }
                                                if !root.form-quake-enabled: CheckBox { text: @tr("ui.profiles.wrap_cycle" => "Wrap to the first window at the end"); checked <=> root.form-cycle; enabled: !root.saving; toggled => { root.profile-changed(); } }
                                                Rectangle { height: 5px; }
                                                Divider {}
                                                SectionLabel { text: @tr("ui.main.quake_mode" => "QUAKE MODE"); height: 23px; }
                                                CheckBox { text: root.form-wezterm-dropdown ? (@tr("ui.quake.wezterm_enabled" => "Enable a dedicated WezTerm dropdown")) : (@tr("ui.quake.enabled" => "Dock one window to the screen edge")); checked <=> root.form-quake-enabled; enabled: !root.saving; toggled => { root.profile-changed(); } }
                                                Caption { text: root.form-wezterm-dropdown ? (@tr("ui.quake.wezterm_hint" => "Opens a dedicated window with your WezTerm shell, font and colors. Terminal tasks keep running while hidden.")) : (@tr("ui.quake.toggle_hint" => "Summon the same window with your shortcut. Press again while it is active to hide it.")); font-size: 11px; }
                                                if root.form-quake-enabled: VerticalLayout {
                                                    spacing: 10px;
                                                    QuakePreview { edge: root.form-quake-edge; alignment: root.form-quake-alignment; width-percent: root.form-quake-width; height-percent: root.form-quake-height; }
                                                    HorizontalLayout {
                                                        spacing: 5px;
                                                        ActionButton { text: @tr("ui.main.top_half" => "Top half"); enabled: !root.saving; clicked => { root.form-quake-edge = 0; root.form-quake-alignment = 1; root.form-quake-width = 100; root.form-quake-height = 50; root.profile-changed(); } }
                                                        ActionButton { text: @tr("ui.main.right_side" => "Right side"); enabled: !root.saving; clicked => { root.form-quake-edge = 3; root.form-quake-alignment = 1; root.form-quake-width = 40; root.form-quake-height = 100; root.profile-changed(); } }
                                                        ActionButton { text: @tr("ui.main.fill_screen" => "Fill screen"); enabled: !root.saving; clicked => { root.form-quake-edge = 0; root.form-quake-alignment = 1; root.form-quake-width = 100; root.form-quake-height = 100; root.profile-changed(); } }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        VerticalLayout {
                                                            spacing: 6px;
                                                            FieldLabel { text: @tr("ui.main.screen_edge" => "Screen edge"); }
                                                            ComboBox { height: 34px; model: [@tr("ui.quake.edge.top" => "Top"), @tr("ui.quake.edge.bottom" => "Bottom"), @tr("ui.quake.edge.left" => "Left"), @tr("ui.quake.edge.right" => "Right")]; current-index <=> root.form-quake-edge; enabled: !root.saving; selected => { root.profile-changed(); } }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 6px;
                                                            FieldLabel { text: @tr("ui.main.alignment" => "Alignment"); }
                                                            ComboBox { height: 34px; model: root.form-quake-edge < 2 ? ([@tr("ui.quake.horizontal_alignment.left" => "Left"), @tr("ui.quake.horizontal_alignment.center" => "Center"), @tr("ui.quake.horizontal_alignment.right" => "Right")]) : ([@tr("ui.quake.vertical_alignment.top" => "Top"), @tr("ui.quake.vertical_alignment.center" => "Center"), @tr("ui.quake.vertical_alignment.bottom" => "Bottom")]); current-index <=> root.form-quake-alignment; enabled: !root.saving; selected => { root.profile-changed(); } }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        VerticalLayout {
                                                            spacing: 6px;
                                                            FieldLabel { text: @tr("ui.quake.width_percent" => "Width · % of work area"); }
                                                            SpinBox { height: 34px; minimum: 10; maximum: 100; step-size: 5; value <=> root.form-quake-width; enabled: !root.saving; edited => { root.profile-changed(); } }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 6px;
                                                            FieldLabel { text: @tr("ui.quake.height_percent" => "Height · % of work area"); }
                                                            SpinBox { height: 34px; minimum: 10; maximum: 100; step-size: 5; value <=> root.form-quake-height; enabled: !root.saving; edited => { root.profile-changed(); } }
                                                        }
                                                    }
                                                    FieldLabel { text: @tr("ui.main.show_on_display" => "Show on display"); }
                                                    ComboBox { height: 34px; model: [@tr("ui.quake.monitor.at_mouse_pointer" => "At mouse pointer"), @tr("ui.quake.monitor.with_foreground_window" => "With foreground window"), @tr("ui.quake.monitor.primary_display" => "Primary display")]; current-index <=> root.form-quake-monitor; enabled: !root.saving; selected => { root.profile-changed(); } }
                                                    CheckBox { text: @tr("ui.quake.always_on_top" => "Keep on top while shown"); checked <=> root.form-quake-topmost; enabled: !root.saving && root.form-platform != 1; toggled => { root.profile-changed(); } }
                                                    CheckBox { text: @tr("ui.quake.hide_on_blur" => "Hide when focus leaves · Windows"); checked <=> root.form-quake-auto-hide; enabled: !root.saving && root.form-platform == 0; toggled => { root.profile-changed(); } }
                                                    Caption { text: root.form-platform == 1 ? (@tr("ui.quake.macos_hint" => "macOS supports placement through Accessibility. Keep-on-top and auto-hide are unavailable.")) : root.form-platform == 2 ? (@tr("ui.quake.linux_hint" => "Requires an X11 / EWMH desktop. Auto-hide is currently available on Windows only.")) : (@tr("ui.quake.placement_hint" => "Uses the display work area, leaving room for the taskbar. Esc stays available to your app.")); font-size: 11px; }
                                                }
                                                Rectangle { height: 5px; }
                                                Divider {}
                                                SectionLabel { text: @tr("ui.main.launch_options" => "LAUNCH OPTIONS"); height: 23px; }
                                                Caption { text: @tr("ui.launch_options.order_hint" => "If the app is closed, try these locations in order."); font-size: 11px; }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    ComboBox { height: 34px; min-width: 120px; model: root.candidate-labels; current-index <=> root.candidate-index; enabled: !root.saving; selected => { root.candidate-selected(self.current-index); } }
                                                    ActionButton { text: @tr("ui.main.add_candidate" => "Add candidate"); icon: @image-url("icons/plus.svg"); with-icon: true; icon-only: true; enabled: root.candidate-labels.length < 8 && !root.saving; clicked => { root.add-candidate(); } }
                                                    ActionButton { text: @tr("ui.main.remove_candidate" => "Remove candidate"); icon: @image-url("icons/minus.svg"); with-icon: true; icon-only: true; enabled: root.candidate-labels.length > 1 && !root.saving; clicked => { root.remove-candidate(); } }
                                                }
                                                FieldLabel { text: @tr("ui.main.executable_or_application" => "Executable or application"); }
                                                HorizontalLayout {
                                                    spacing: 7px;
                                                    LineEdit { height: 34px; min-width: 100px; text <=> root.launch-executable; placeholder-text: @tr("ui.main.choose_a_program" => "Choose a program…"); enabled: !root.saving; edited => { root.profile-changed(); } }
                                                    ActionButton { text: @tr("ui.action.browse" => "Browse"); enabled: !root.saving; clicked => { root.browse-path(0); } }
                                                }
                                                FieldLabel { text: @tr("ui.main.arguments_json_array" => "Arguments · JSON array"); }
                                                LineEdit { height: 34px; text <=> root.launch-args; placeholder-text: "[\"--new-window\"]"; enabled: !root.saving; edited => { root.profile-changed(); } }
                                                Caption { text: @tr("ui.launch_options.arguments_hint" => "Use [] for no arguments; each argument is a quoted string."); font-size: 11px; }
                                                FieldLabel { text: @tr("ui.main.working_directory_optional" => "Working directory · optional"); }
                                                HorizontalLayout {
                                                    spacing: 7px;
                                                    LineEdit { height: 34px; min-width: 100px; text <=> root.launch-cwd; placeholder-text: @tr("ui.main.default_directory" => "Default directory"); enabled: !root.saving; edited => { root.profile-changed(); } }
                                                    ActionButton { text: @tr("ui.action.browse" => "Browse"); enabled: !root.saving; clicked => { root.browse-path(1); } }
                                                }
                                                Rectangle { min-height: 4px; vertical-stretch: 1; }
                                            }
                                        }
                                        Divider {}
                                        HorizontalLayout {
                                            spacing: 7px;
                                            ActionButton { text: @tr("ui.action.delete" => "Delete"); danger: true; subtle: true; enabled: root.selected-profile >= 0 && !root.saving; clicked => { root.delete-profile(); } }
                                            Rectangle { horizontal-stretch: 1; }
                                            ActionButton { text: @tr("ui.action.cancel" => "Cancel"); enabled: !root.saving; clicked => { root.cancel-profile(); } }
                                            ActionButton { text: root.saving ? (@tr("ui.status.saving" => "Saving…")) : (@tr("ui.main.save_app" => "Save app")); primary: true; enabled: root.loaded && !root.saving; clicked => { root.save-profile(); } }
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            visible: root.page == 2;
                            spacing: 14px;
                            ScrollView {
                                vertical-stretch: 1;
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout {
                                    padding-right: 8px;
                                    spacing: 13px;
                                    SectionLabel { text: @tr("ui.main.appearance" => "APPEARANCE"); height: 18px; }
                                    Card {
                                        VerticalLayout {
                                            padding: 18px; spacing: 12px;
                                            FieldLabel { text: @tr("ui.main.choose_your_theme" => "Choose your theme"); }
                                            Caption { text: @tr("ui.settings.theme_hint" => "Preview instantly in the manager and project launcher. Save to keep your choice."); }
                                            HorizontalLayout {
                                                spacing: 12px;
                                                ThemeChoice { text: @tr("ui.main.system" => "System"); scheme: 0; selected: root.setting-theme == 0; enabled: root.loaded && !root.saving; clicked => { root.setting-theme = 0; root.settings-changed(); } }
                                                ThemeChoice { text: @tr("ui.main.light" => "Light"); scheme: 1; selected: root.setting-theme == 1; enabled: root.loaded && !root.saving; clicked => { root.setting-theme = 1; root.settings-changed(); } }
                                                ThemeChoice { text: @tr("ui.main.dark" => "Dark"); scheme: 2; selected: root.setting-theme == 2; enabled: root.loaded && !root.saving; clicked => { root.setting-theme = 2; root.settings-changed(); } }
                                            }
                                        }
                                    }
                                    SectionLabel { text: @tr("ui.main.general" => "GENERAL"); height: 18px; }
                                    Card {
                                        VerticalLayout {
                                            spacing: 0px;
                                            SettingRow {
                                                title: @tr("ui.main.language" => "Language");
                                                description: @tr("ui.settings.language_hint" => "Preview immediately. Save to keep your choice.");
                                                // Autonyms keep both choices recognizable in either locale.
                                                ComboBox {
                                                    model: ["简体中文", "English"];
                                                    current-index <=> root.setting-language;
                                                    enabled: root.loaded && !root.saving;
                                                    selected => { root.settings-changed(); }
                                                }
                                            }
                                            Divider {}
                                            SettingRow {
                                                title: @tr("ui.main.open_toolbox" => "Open toolbox");
                                                description: @tr("ui.settings.hotkey_hint" => "A global shortcut to your recent projects.");
                                                LineEdit { height: 34px; text <=> root.setting-hotkey; enabled: root.loaded && !root.saving; edited => { root.settings-changed(); } }
                                            }
                                            Divider {}
                                            SettingRow {
                                                title: @tr("ui.main.launch_at_sign_in" => "Launch at sign-in");
                                                description: @tr("ui.settings.autostart_hint" => "Keep your shortcuts ready when you sign in.");
                                                Switch { checked <=> root.setting-autostart; accessible-label: @tr("ui.main.launch_at_sign_in" => "Launch at sign-in"); enabled: root.loaded && !root.saving; toggled => { root.settings-changed(); } }
                                            }
                                            Divider {}
                                            SettingRow {
                                                title: @tr("ui.settings.idle_timeout" => "Automatic-hide cache · seconds");
                                                description: @tr("ui.settings.idle_hint" => "0 releases memory immediately; up to 3600 keeps reopening fast. Close or Esc always releases the last UI.");
                                                LineEdit { height: 34px; width: 100px; text <=> root.setting-idle; input-type: number; enabled: root.loaded && !root.saving; edited => { root.settings-changed(); } }
                                            }
                                        }
                                    }
                                    Rectangle { height: 2px; }
                                    SectionLabel { text: @tr("ui.main.tools" => "TOOLS"); height: 18px; }
                                    Card {
                                        VerticalLayout {
                                            spacing: 0px;
                                            SettingRow {
                                                title: @tr("ui.navigation.projects" => "Recent projects");
                                                description: @tr("ui.settings.projects_hint" => "Find folders and workspaces from VS Code history.");
                                                Switch { checked <=> root.setting-projects; accessible-label: @tr("ui.main.enable_recent_projects" => "Enable recent projects"); enabled: root.loaded && !root.saving; toggled => { root.settings-changed(); } }
                                            }
                                            Divider {}
                                            SettingRow {
                                                title: @tr("ui.navigation.windows" => "Window switcher");
                                                description: @tr("ui.settings.windows_hint" => "Launch, focus and minimize apps with a shortcut.");
                                                Switch { checked <=> root.setting-windows; accessible-label: @tr("ui.main.enable_window_switcher" => "Enable window switcher"); enabled: root.loaded && !root.saving; toggled => { root.settings-changed(); } }
                                            }
                                            Divider {}
                                            VerticalLayout {
                                                padding: 18px; spacing: 8px;
                                                Text { text: @tr("ui.main.vs_code_location" => "VS Code location"); color: Theme.text; font-size: 13px; font-weight: 600; }
                                                Caption { text: @tr("ui.settings.code_path_hint" => "Leave empty to locate VS Code automatically."); }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    LineEdit { height: 34px; text <=> root.setting-code-path; placeholder-text: @tr("ui.main.automatically_detect" => "Automatically detect"); enabled: root.loaded && !root.saving; edited => { root.settings-changed(); } }
                                                    ActionButton { text: @tr("ui.action.browse" => "Browse"); enabled: root.loaded && !root.saving; clicked => { root.browse-path(2); } }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 2px; }
                                    SectionLabel { text: @tr("ui.main.configuration" => "CONFIGURATION"); height: 18px; }
                                    Card {
                                        VerticalLayout {
                                            padding: 18px; spacing: 13px;
                                            Caption { text: @tr("ui.settings.import_export_hint" => "Import a WinGuake INI or Toolbox JSON with a preview. Export backs up the configuration currently in use."); }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                ActionButton { text: @tr("ui.main.import" => "Import…"); icon: @image-url("icons/download.svg"); with-icon: true; enabled: root.loaded && !root.saving; clicked => { root.import-config(); } }
                                                ActionButton { text: @tr("ui.main.export_json" => "Export JSON…"); icon: @image-url("icons/upload.svg"); with-icon: true; enabled: root.loaded && !root.saving; clicked => { root.export-config(); } }
                                                ActionButton { text: @tr("ui.main.reload_saved" => "Reload saved"); subtle: true; enabled: !root.saving; clicked => { root.reload-config(); } }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                    Rectangle { min-height: 3px; vertical-stretch: 1; }
                                }
                            }
                            Divider {}
                            HorizontalLayout {
                                height: 40px; spacing: 10px;
                                VerticalLayout { width: 6px; alignment: center; Rectangle { height: 6px; border-radius: 3px; background: root.settings-dirty ? Theme.warning : Theme.success; } }
                                Caption { text: root.settings-dirty ? (@tr("ui.main.you_have_unsaved_changes" => "You have unsaved changes")) : (@tr("ui.main.all_changes_saved" => "All changes saved")); horizontal-stretch: 1; }
                                ActionButton { text: @tr("ui.action.discard" => "Discard"); subtle: true; enabled: root.settings-dirty && !root.saving; clicked => { root.reset-settings(); } }
                                ActionButton { text: root.saving ? (@tr("ui.status.saving" => "Saving…")) : (@tr("ui.main.save_settings" => "Save settings")); enabled: root.loaded && root.settings-dirty && !root.saving; primary: true; clicked => { root.save-settings(); } }
                            }
                        }
                        // No explicit width: it would pin the page's max-width to its
                        // current width, and that cap becomes the window's maximum size.
                        skills-page := SkillsPage {
                            horizontal-stretch: 1;
                            visible: root.page == 4;
                            enabled: root.loaded && !root.blocked;
                        }
                        VerticalLayout {
                            visible: root.page == 3;
                            spacing: 14px;
                            HorizontalLayout {
                                height: 34px; spacing: 10px;
                                SectionLabel { text: @tr("ui.main.device_capabilities" => "DEVICE CAPABILITIES"); }
                                if root.diagnostic-loaded: Caption { text: root.diagnostic-platform + " · " + root.diagnostic-backend; }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton { text: root.diagnostic-loading ? (@tr("ui.main.checking" => "Checking…")) : (@tr("ui.main.check_again" => "Check again")); with-icon: true; icon: @image-url("icons/refresh.svg"); enabled: !root.diagnostic-loading; clicked => { root.refresh-status(); } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                CapabilityCard { title: @tr("ui.main.window_control" => "Window control"); icon: @image-url("icons/windows.svg"); ready: root.diagnostic-loaded; available: root.diagnostic-window-control; value: !root.diagnostic-loaded ? (@tr("ui.status.unchecked" => "Unchecked")) : root.diagnostic-window-control ? (@tr("ui.status.available" => "Available")) : (@tr("ui.status.unavailable" => "Unavailable")); }
                                CapabilityCard { title: @tr("ui.main.global_shortcuts" => "Global shortcuts"); icon: @image-url("icons/keyboard.svg"); ready: root.diagnostic-loaded; available: root.diagnostic-hotkeys; value: !root.diagnostic-loaded ? (@tr("ui.status.unchecked" => "Unchecked")) : root.diagnostic-hotkeys ? (@tr("ui.status.available" => "Available")) : (@tr("ui.status.unavailable" => "Unavailable")); }
                                CapabilityCard { title: @tr("ui.main.system_tray" => "System tray"); icon: @image-url("icons/box.svg"); ready: root.diagnostic-loaded; available: root.diagnostic-tray; value: !root.diagnostic-loaded ? (@tr("ui.status.unchecked" => "Unchecked")) : root.diagnostic-tray ? (@tr("ui.status.available" => "Available")) : (@tr("ui.status.unavailable" => "Unavailable")); }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout {
                                    padding-right: 8px; spacing: 12px;
                                    Card {
                                        VerticalLayout {
                                            padding: 18px; spacing: 10px;
                                            SectionLabel { text: @tr("ui.main.last_action" => "LAST ACTION"); }
                                            Caption { text: root.diagnostic-last-action == "" ? (@tr("ui.main.no_actions_recorded_yet" => "No actions recorded yet.")) : root.diagnostic-last-action; color: Theme.secondary; font-size: 13px; }
                                        }
                                    }
                                    if root.diagnostic-warnings != "": Card {
                                        background: Theme.warning-soft; border-color: Theme.warning-border;
                                        VerticalLayout {
                                            padding: 18px; spacing: 10px;
                                            FieldLabel { text: @tr("ui.main.needs_your_attention" => "Needs your attention"); color: Theme.warning; }
                                            Caption { text: root.diagnostic-warnings; color: Theme.warning; }
                                        }
                                    }
                                    if root.diagnostic-error != "": Card {
                                        background: Theme.danger-soft; border-color: Theme.danger-border;
                                        VerticalLayout {
                                            padding: 18px; spacing: 10px;
                                            FieldLabel { text: @tr("ui.main.last_interface_error" => "Last interface error"); color: Theme.danger; }
                                            Caption { text: root.diagnostic-error; color: Theme.danger; }
                                        }
                                    }
                                    ActionButton {
                                        text: root.diagnostics-expanded ? (@tr("ui.main.hide_technical_details" => "Hide technical details")) : (@tr("ui.main.show_technical_details" => "Show technical details"));
                                        subtle: true; with-icon: true; icon: @image-url("icons/info.svg");
                                        clicked => { root.diagnostics-expanded = !root.diagnostics-expanded; }
                                    }
                                    if root.diagnostics-expanded: TextEdit { text: root.diagnostics; read-only: true; height: 260px; }
                                    Rectangle { min-height: 0px; vertical-stretch: 1; }
                                }
                            }
                            Card {
                                HorizontalLayout {
                                    padding: 18px; spacing: 18px;
                                    VerticalLayout {
                                        alignment: center; spacing: 10px; horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: "Sean Toolbox"; color: Theme.text; font-size: 16px; font-weight: 600; }
                                            Text { text: root.version-label; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        Caption { text: @tr("ui.about.description" => "An independent, local-first personal toolbox."); }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            ActionButton { text: @tr("ui.main.project_licenses" => "Project & licenses"); with-icon: true; icon: @image-url("icons/external.svg"); clicked => { root.open-link(0); } }
                                            ActionButton { text: @tr("ui.main.slint_website" => "Slint website"); subtle: true; clicked => { root.open-link(1); } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    AboutSlint { width: 168px; height: 108px; }
                                }
                            }
                        }
                    }
                    // The skills page has its own status line; keep the shared one for errors only.
                    if root.page != 4 || root.status-error: Rectangle {
                        height: root.status-error ? 62px : 24px;
                        border-radius: 7px;
                        background: root.status-error ? Theme.danger-soft : transparent;
                        HorizontalLayout {
                            padding: root.status-error ? 10px : 0px;
                            spacing: 8px;
                            Icon { source: root.status-error ? @image-url("icons/warning.svg") : @image-url("icons/check.svg"); width: 14px; colorize: root.status-error ? Theme.danger : Theme.muted; }
                            Text { text: root.status-message; color: root.status-error ? Theme.danger : Theme.muted; font-size: 11px; wrap: word-wrap; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.status-error && root.page != 3: ActionButton { text: @tr("ui.action.details" => "Details"); subtle: true; clicked => { root.navigate(3); } }
                        }
                    }
                }
            }
        }
        Rectangle {
            visible: root.import-visible;
            background: Theme.scrim;
            TouchArea {}
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(720px, parent.width - 64px);
                height: min(570px, parent.height - 64px);
                border-radius: 14px;
                VerticalLayout {
                    padding: 26px; spacing: 16px;
                    Text { text: @tr("ui.main.review_your_import" => "Review your import"); color: Theme.text; font-size: 22px; font-weight: 700; }
                    Caption { text: @tr("ui.import.review_hint" => "Review the applications below before applying changes."); }
                    TextEdit { text: root.import-summary; read-only: true; vertical-stretch: 1; }
                    if root.status-error: Caption { text: root.status-message; color: Theme.danger; }
                    Caption { text: @tr("ui.import.merge_hint" => "Merge replaces matching app IDs. Replace removes the existing app list; JSON also replaces settings. No application is launched."); }
                    Divider {}
                    HorizontalLayout {
                        spacing: 8px;
                        import-cancel := ActionButton { text: @tr("ui.action.cancel" => "Cancel"); enabled: !root.saving; clicked => { root.cancel-import(); } }
                        Rectangle { horizontal-stretch: 1; }
                        import-replace := ActionButton { text: root.import-is-json ? (@tr("ui.main.replace_all" => "Replace all")) : (@tr("ui.main.replace_app_list" => "Replace app list")); danger: true; enabled: !root.saving; clicked => { root.apply-import(true); } }
                        import-merge := ActionButton { text: @tr("ui.main.merge_apps" => "Merge apps"); primary: true; enabled: !root.saving; clicked => { root.apply-import(false); } }
                    }
                }
            }
        }
        Rectangle {
            visible: root.confirm-visible;
            background: Theme.scrim;
            TouchArea {}
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(480px, parent.width - 64px);
                height: 234px;
                border-radius: 14px;
                VerticalLayout {
                    padding: 26px; spacing: 15px;
                    HorizontalLayout {
                        spacing: 12px;
                        Icon { source: @image-url("icons/info.svg"); colorize: Theme.warning; width: 23px; }
                        Text { text: root.confirm-title; color: Theme.text; font-size: 18px; font-weight: 600; horizontal-stretch: 1; wrap: word-wrap; }
                    }
                    Caption { text: root.confirm-message; font-size: 13px; vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 9px;
                        Rectangle { horizontal-stretch: 1; }
                        confirm-cancel := ActionButton { text: @tr("ui.action.keep_editing" => "Keep editing"); clicked => { root.confirm-action(false); } }
                        confirm-continue := ActionButton { text: @tr("ui.action.continue" => "Continue"); primary: true; clicked => { root.confirm-action(true); } }
                    }
                }
            }
        }
        if root.dialog-busy: Rectangle {
            background: Theme.busy-scrim;
            TouchArea {}
            VerticalLayout {
                alignment: center; spacing: 18px;
                HorizontalLayout { alignment: center; Spinner { width: 28px; height: 28px; } }
                Text { text: @tr("ui.dialog.file_chooser_hint" => "Continue in the file chooser"); color: Theme.text; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
            }
        }
    }
}
