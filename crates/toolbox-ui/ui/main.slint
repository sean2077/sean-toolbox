                                                if root.form-hotkey-error != "": Caption { text: root.form-hotkey-error; color: Theme.danger; }
                                                CheckBox { text: @tr("ui.main.enable_this_application" => "Enable this application"); checked <=> root.form-enabled; enabled: !root.saving; toggled => { root.profile-changed(); } }
                                                Divider {}
                                                FieldLabel { text: @tr("ui.profiles.window_behavior" => "Window behavior"); }
                                                CheckBox { text: root.form-wezterm-dropdown ? @tr("ui.quake.wezterm_enabled" => "Enable a dedicated WezTerm dropdown") : @tr("ui.quake.enabled" => "Dock one window to the screen edge"); checked <=> root.form-quake-enabled; enabled: !root.saving; toggled => { root.profile-changed(); } }
                                                if !root.form-quake-enabled: VerticalLayout {
                                                    spacing: 7px;
                                                    CheckBox { text: @tr("ui.profiles.maximize_new" => "Maximize newly launched windows only"); checked <=> root.form-maximize; enabled: !root.saving; toggled => { root.profile-changed(); } }
                                                    CheckBox { text: @tr("ui.profiles.wrap_cycle" => "Wrap to the first window at the end"); checked <=> root.form-cycle; enabled: !root.saving; toggled => { root.profile-changed(); } }
                                                }
