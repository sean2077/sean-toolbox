                                                    spacing: 7px;
                                                    profile-program := LineEdit { height: 36px; min-width: 100px; text <=> root.launch-executable; accessible-label: @tr("ui.profiles.program" => "Program"); placeholder-text: @tr("ui.main.choose_a_program" => "Choose a program…"); enabled: !root.saving; edited => { root.program-edited(); } }
                                                    ActionButton { text: @tr("ui.action.browse" => "Browse"); enabled: !root.saving; clicked => { root.browse-path(0); } }
