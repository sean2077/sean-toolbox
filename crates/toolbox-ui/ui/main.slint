                                        VerticalLayout {
                                            spacing: 3px;
                                            for item in root.profiles: ProfileItem {
                                                item: item;
                                                selected: root.selected-profile == item.source-index;
                                                enabled: !root.saving;
                                                clicked => { root.edit-profile(item.source-index); }
