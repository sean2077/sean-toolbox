                                            if root.profiles.length == 0: Caption { text: root.profile-query != "" ? @tr("ui.profiles.no_matches" => "No matching apps. Try a name or shortcut.") : @tr("ui.profiles.empty_hint" => "No applications yet. Add one to create your first shortcut."); }
                                            Rectangle { min-height: 0px; vertical-stretch: 1; }
                                        }
                                    }
                                }
