                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        ComboBox { height: 34px; min-width: 120px; model: root.candidate-labels; current-index <=> root.candidate-index; accessible-label: @tr("ui.main.launch_options" => "LAUNCH OPTIONS"); enabled: !root.saving; selected => { root.candidate-selected(self.current-index); } }
                                                        ActionButton { text: @tr("ui.main.add_candidate" => "Add candidate"); icon: @image-url("icons/plus.svg"); with-icon: true; icon-only: true; enabled: root.candidate-labels.length < 8 && !root.saving; clicked => { root.add-candidate(); } }
                                                        ActionButton { text: @tr("ui.main.remove_candidate" => "Remove candidate"); icon: @image-url("icons/minus.svg"); with-icon: true; icon-only: true; enabled: root.candidate-labels.length > 1 && !root.saving; clicked => { root.remove-candidate(); } }
                                                    }
                                                    if root.candidate-labels.length > 1: LineEdit { height: 34px; text <=> root.launch-executable; accessible-label: @tr("ui.profiles.program" => "Program"); placeholder-text: @tr("ui.main.choose_a_program" => "Choose a program…"); enabled: !root.saving; edited => { root.program-edited(); } }
                                                    FieldLabel { text: @tr("ui.main.arguments_json_array" => "Arguments · JSON array"); }
                                                    profile-args := LineEdit { height: 34px; text <=> root.launch-args; accessible-label: @tr("ui.main.arguments_json_array" => "Arguments · JSON array"); placeholder-text: "[\"--new-window\"]"; enabled: !root.saving; edited => { root.profile-changed(); } }
                                                    Caption { text: @tr("ui.launch_options.arguments_hint" => "Use [] for no arguments; each argument is a quoted string."); }
                                                    if root.form-args-error != "": Caption { text: root.form-args-error; color: Theme.danger; }
                                                    FieldLabel { text: @tr("ui.main.working_directory_optional" => "Working directory · optional"); }
                                                    HorizontalLayout {
                                                        spacing: 7px;
                                                        LineEdit { height: 34px; min-width: 100px; text <=> root.launch-cwd; accessible-label: @tr("ui.main.working_directory_optional" => "Working directory · optional"); placeholder-text: @tr("ui.main.default_directory" => "Default directory"); enabled: !root.saving; edited => { root.profile-changed(); } }
                                                        ActionButton { text: @tr("ui.action.browse" => "Browse"); enabled: !root.saving; clicked => { root.browse-path(1); } }
                                                    }
                                                }
                                                Rectangle { min-height: 3px; vertical-stretch: 1; }
                                            }
                                        }
                                        Divider {}
                                        HorizontalLayout {
                                            spacing: 7px;
                                            ActionButton { text: @tr("ui.action.delete" => "Delete"); danger: true; subtle: true; enabled: root.selected-profile >= 0 && !root.saving; clicked => { root.delete-profile(); } }
                                            Rectangle { horizontal-stretch: 1; }
                                            ActionButton { text: root.profile-dirty ? @tr("ui.action.discard" => "Discard") : @tr("ui.profiles.close_details" => "Close"); enabled: !root.saving; clicked => { root.cancel-profile(); } }
                                            ActionButton { text: root.saving ? @tr("ui.status.saving" => "Saving…") : @tr("ui.main.save_app" => "Save app"); primary: true; enabled: root.loaded && root.profile-dirty && !root.saving; clicked => { root.save-profile(); } }
                                        }
                                    }
