                                    horizontal-stretch: 1;
                                    if !root.editing: VerticalLayout {
                                        padding: 24px; alignment: center; spacing: 14px;
                                        HorizontalLayout { alignment: center; Icon { width: 30px; height: 30px; source: @image-url("icons/keyboard.svg"); colorize: Theme.accent; } }
                                        Text { text: @tr("ui.profiles.select_title" => "Choose an application"); font-size: 18px; font-weight: 600; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                                        Caption { text: @tr("ui.profiles.select_hint" => "Select an app to edit its shortcut and window behavior, or add a new app."); horizontal-alignment: center; }
                                        HorizontalLayout { alignment: center; ActionButton { text: @tr("ui.main.add_application" => "Add application"); primary: true; enabled: root.loaded && !root.saving; clicked => { root.new-profile(); } } }
