                                            Caption { text: root.profile-dirty ? @tr("ui.main.unsaved" => "Unsaved") : @tr("ui.main.saved" => "Saved"); color: root.profile-dirty ? Theme.warning : Theme.muted; }
                                            ActionButton {
                                                text: @tr("ui.profiles.test_saved" => "Test saved");
                                                enabled: root.profile-testable && root.windows-enabled && !root.saving;
                                                clicked => { root.toggle-profile(root.selected-profile); }
                                                Tooltip { Hint { text: root.profile-testable && root.windows-enabled ? @tr("ui.profiles.test_hint" => "Runs the saved app configuration. Unsaved changes stay in the editor.") : @tr("ui.profiles.test_unavailable" => "Save and enable this app for the current operating system to test it."); } }
                                            }
                                        }
                                        Divider {}
                                        if root.profile-error != "": Caption { text: root.profile-error; color: Theme.danger; }
                                        profile-scroll := ScrollView {
                                            horizontal-scrollbar-policy: always-off;
                                            content-width: self.visible-width;
                                            vertical-stretch: 1;
                                            VerticalLayout {
