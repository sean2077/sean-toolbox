                                                    spacing: 9px;
                                                    Caption { text: root.form-wezterm-dropdown ? @tr("ui.quake.wezterm_hint" => "Opens a dedicated window with your WezTerm shell, font and colors. Terminal tasks keep running while hidden.") : @tr("ui.quake.toggle_hint" => "Summon the same window with your shortcut. Press again while it is active to hide it."); }
                                                    QuakePreview { edge: root.form-quake-edge; alignment: root.form-quake-alignment; width-percent: root.form-quake-width; height-percent: root.form-quake-height; }
                                                    HorizontalLayout {
                                                        spacing: 5px;
                                                        ActionButton { text: @tr("ui.main.top_half" => "Top half"); enabled: !root.saving; clicked => { root.form-quake-edge = 0; root.form-quake-alignment = 1; root.form-quake-width = 100; root.form-quake-height = 50; root.profile-changed(); } }
                                                        ActionButton { text: @tr("ui.main.right_side" => "Right side"); enabled: !root.saving; clicked => { root.form-quake-edge = 3; root.form-quake-alignment = 1; root.form-quake-width = 40; root.form-quake-height = 100; root.profile-changed(); } }
                                                        ActionButton { text: @tr("ui.main.fill_screen" => "Fill screen"); enabled: !root.saving; clicked => { root.form-quake-edge = 0; root.form-quake-alignment = 1; root.form-quake-width = 100; root.form-quake-height = 100; root.profile-changed(); } }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        VerticalLayout {
                                                            spacing: 5px;
                                                            FieldLabel { text: @tr("ui.main.screen_edge" => "Screen edge"); }
                                                            ComboBox { height: 34px; model: [@tr("ui.quake.edge.top" => "Top"), @tr("ui.quake.edge.bottom" => "Bottom"), @tr("ui.quake.edge.left" => "Left"), @tr("ui.quake.edge.right" => "Right")]; current-index <=> root.form-quake-edge; accessible-label: @tr("ui.main.screen_edge" => "Screen edge"); enabled: !root.saving; selected => { root.profile-changed(); } }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 5px;
                                                            FieldLabel { text: @tr("ui.main.alignment" => "Alignment"); }
                                                            ComboBox { height: 34px; model: root.form-quake-edge < 2 ? [@tr("ui.quake.horizontal_alignment.left" => "Left"), @tr("ui.quake.horizontal_alignment.center" => "Center"), @tr("ui.quake.horizontal_alignment.right" => "Right")] : [@tr("ui.quake.vertical_alignment.top" => "Top"), @tr("ui.quake.vertical_alignment.center" => "Center"), @tr("ui.quake.vertical_alignment.bottom" => "Bottom")]; current-index <=> root.form-quake-alignment; accessible-label: @tr("ui.main.alignment" => "Alignment"); enabled: !root.saving; selected => { root.profile-changed(); } }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        VerticalLayout {
                                                            spacing: 5px;
                                                            FieldLabel { text: @tr("ui.quake.width_percent" => "Width · % of work area"); }
                                                            SpinBox { height: 34px; minimum: 10; maximum: 100; step-size: 5; value <=> root.form-quake-width; accessible-label: @tr("ui.quake.width_percent" => "Width · % of work area"); enabled: !root.saving; edited => { root.profile-changed(); } }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 5px;
                                                            FieldLabel { text: @tr("ui.quake.height_percent" => "Height · % of work area"); }
                                                            SpinBox { height: 34px; minimum: 10; maximum: 100; step-size: 5; value <=> root.form-quake-height; accessible-label: @tr("ui.quake.height_percent" => "Height · % of work area"); enabled: !root.saving; edited => { root.profile-changed(); } }
                                                        }
                                                    }
                                                    FieldLabel { text: @tr("ui.main.show_on_display" => "Show on display"); }
                                                    ComboBox { height: 34px; model: [@tr("ui.quake.monitor.at_mouse_pointer" => "At mouse pointer"), @tr("ui.quake.monitor.with_foreground_window" => "With foreground window"), @tr("ui.quake.monitor.primary_display" => "Primary display")]; current-index <=> root.form-quake-monitor; accessible-label: @tr("ui.main.show_on_display" => "Show on display"); enabled: !root.saving; selected => { root.profile-changed(); } }
                                                    CheckBox { text: @tr("ui.quake.always_on_top" => "Keep on top while shown"); checked <=> root.form-quake-topmost; enabled: !root.saving && root.form-platform != 1; toggled => { root.profile-changed(); } }
                                                    CheckBox { text: @tr("ui.quake.hide_on_blur" => "Hide when focus leaves · Windows"); checked <=> root.form-quake-auto-hide; enabled: !root.saving && root.form-platform == 0; toggled => { root.profile-changed(); } }
                                                    Caption { text: root.form-platform == 1 ? @tr("ui.quake.macos_hint" => "macOS supports placement through Accessibility. Keep-on-top and auto-hide are unavailable.") : root.form-platform == 2 ? @tr("ui.quake.linux_hint" => "Requires an X11 / EWMH desktop. Auto-hide is currently available on Windows only.") : @tr("ui.quake.placement_hint" => "Uses the display work area, leaving room for the taskbar. Esc stays available to your app."); }
                                                }
                                                Divider {}
                                                advanced-toggle := ActionButton {
                                                    text: root.form-advanced ? @tr("ui.profiles.hide_advanced" => "Hide advanced options") : @tr("ui.profiles.show_advanced" => "Advanced options");
                                                    subtle: true; with-icon: true; icon: root.form-advanced ? @image-url("icons/minus.svg") : @image-url("icons/plus.svg");
                                                    clicked => { root.form-advanced = !root.form-advanced; }
                                                }
                                                if root.form-advanced: VerticalLayout {
                                                    spacing: 8px;
                                                    Caption { text: @tr("ui.profiles.advanced_hint" => "Adjust matching rules and launch alternatives when automatic suggestions do not fit your app."); }
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        VerticalLayout {
                                                            spacing: 5px;
                                                            FieldLabel { text: @tr("ui.main.application_id" => "Application ID"); }
                                                            profile-id := LineEdit { height: 34px; min-width: 100px; text <=> root.form-id; accessible-label: @tr("ui.main.application_id" => "Application ID"); enabled: !root.saving; edited => { root.profile-changed(); } }
                                                        }
                                                        VerticalLayout {
                                                            width: 112px; spacing: 5px;
                                                            FieldLabel { text: @tr("ui.main.platform" => "Platform"); }
                                                            ComboBox { height: 34px; min-width: 100px; model: ["Windows", "macOS", "Linux"]; current-index <=> root.form-platform; accessible-label: @tr("ui.main.platform" => "Platform"); enabled: !root.saving; selected => { root.profile-changed(); } }
                                                        }
                                                    }
                                                    if root.form-id-error != "": Caption { text: root.form-id-error; color: Theme.danger; }
                                                    FieldLabel { text: @tr("ui.main.window_match" => "Window match"); }
                                                    profile-matcher := LineEdit { height: 34px; text <=> root.form-matcher; accessible-label: @tr("ui.main.window_match" => "Window match"); placeholder-text: root.form-platform == 0 ? "Code.exe" : root.form-platform == 1 ? "com.microsoft.VSCode" : "Code"; enabled: !root.saving; edited => { root.profile-changed(); } }
                                                    Caption { text: root.profile-help; }
                                                    if root.form-matcher-error != "": Caption { text: root.form-matcher-error; color: Theme.danger; }
