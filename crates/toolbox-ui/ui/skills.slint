import { CheckBox, ComboBox, LineEdit, ScrollView, Spinner, Switch } from "std-widgets.slint";
import { Theme, ActionButton, Caption, Card, Divider, FieldLabel, Icon, SectionLabel } from "components.slint";

component SkillPathHint inherits Rectangle {
    in property <string> text;
    max-width: 620px;
    border-radius: 5px;
    background: Theme.tooltip;
    VerticalLayout {
        padding: 10px;
        Text { text: root.text; color: Theme.on-accent; font-size: 12px; wrap: word-wrap; }
    }
}

component SkillChip inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    // When set, the chip is a link: a URL or a local folder opened on click.
    in property <string> link;
    in property <string> link-hint;
    callback clicked;
    private property <bool> hovered: root.link != "" && touch.has-hover;
    height: 18px;
    max-width: 240px;
    min-width: label.preferred-width + 12px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.hovered ? Theme.accent : root.accent ? Theme.accent-border : Theme.border;
    background: root.hovered ? Theme.accent-soft : root.accent ? Theme.accent-soft : Theme.raised;
    accessible-role: button;
    accessible-label: root.link != "" ? root.link-hint : root.text;
    accessible-action-default => { if root.link != "" { root.clicked(); } }
    touch := TouchArea {
        enabled: root.link != "";
        mouse-cursor: root.link != "" ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.link != "": Tooltip { SkillPathHint { text: root.link-hint; } }
    label := Text {
        text: root.text;
        color: root.hovered || root.accent ? Theme.accent : Theme.muted;
        font-size: 10px;
        overflow: elide;
        min-width: 0px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component AppToggle inherits Rectangle {
    in property <image> icon;
    in property <string> name;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 26px;
    height: 22px;
    border-radius: 5px;
    border-width: keys.has-focus ? 2px : 1px;
    border-color: keys.has-focus ? Theme.focus : root.checked ? Theme.accent-border : Theme.border;
    background: root.checked ? Theme.accent-soft : touch.has-hover ? Theme.hover : Theme.panel;
    opacity: root.enabled ? 1 : 0.45;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 15px;
        height: 15px;
        source: root.icon;
        image-fit: contain;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.toggled(!root.checked); }
    }
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.toggled(!root.checked); return accept; }
            reject
        }
    }
    accessible-role: checkbox;
    accessible-label: root.name;
    accessible-checked: root.checked;
    Tooltip { SkillPathHint { text: root.name; } }
}

component RowMenuButton inherits Rectangle {
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    width: 28px;
    height: 24px;
    border-radius: 5px;
    background: touch.has-hover || keys.has-focus ? Theme.hover : transparent;
    border-width: keys.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    opacity: root.enabled ? 1 : 0.45;
    Text {
        text: "···";
        color: Theme.muted;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.clicked(); }
    }
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; }
            reject
        }
    }
    accessible-role: button;
    accessible-label: root.tip;
    Tooltip { SkillPathHint { text: root.tip; } }
}

// One entry of a row's action menu: icon, label and an optional right-side hint.
component SkillMenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> hint;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback activated;
    height: 32px;
    border-radius: 5px;
    background: root.enabled && touch.has-hover ? (root.danger ? Theme.danger-soft : Theme.hover) : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 15px;
                height: 15px;
                source: root.icon;
                colorize: !root.enabled ? Theme.disabled : root.danger ? Theme.danger : Theme.secondary;
            }
        }
        Text {
            text: root.text;
            color: !root.enabled ? Theme.disabled : root.danger ? Theme.danger : Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.disabled;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export struct SkillListRow {
    id: string,
    name: string,
    detail: string,
    description: string,
    installed: bool,
    problem: bool,
    linked: bool,
    selected: bool,
    updatable: bool,
    source: string,
    source-target: string,
    status: string,
    enabled: bool,
    app0: bool,
    app1: bool,
    app2: bool,
    app3: bool,
    app4: bool,
}
export struct SkillAppRow { index: int, name: string, path: string, enabled: bool }
export struct SkillRepositoryRow { id: string, url: string, detail: string, error: string, removable: bool }

export global SkillsState {
    in-out property <bool> loaded: false;
    in-out property <bool> loading: false;
    in-out property <bool> submitting: false;
    in-out property <bool> busy: false;
    in-out property <bool> daily-update: false;
    in-out property <int> view: 0;
    in-out property <string> query;
    in-out property <[SkillListRow]> rows;
    in-out property <[SkillRepositoryRow]> repositories;
    in-out property <[SkillAppRow]> apps;
    in-out property <int> installed-count;
    in-out property <string> selected-id;
    in-out property <string> selected-name;
    in-out property <string> selected-description;
    in-out property <string> selected-source;
    in-out property <string> selected-detail;
    in-out property <string> selected-summary;
    in-out property <string> selected-error;
    in-out property <bool> selected-installed: false;
    in-out property <bool> selected-updatable: false;
    in-out property <bool> selected-linked: false;
    in-out property <int> status-filter: 0;
    in-out property <int> source-filter: 0;
    in-out property <[string]> source-options: [];
    in-out property <string> app-counts-text;
    in-out property <bool> all-selected: false;
    in-out property <int> selected-count: 0;
    in-out property <bool> batch-app0: false;
    in-out property <bool> batch-app1: false;
    in-out property <bool> batch-app2: false;
    in-out property <bool> batch-app3: false;
    in-out property <bool> batch-app4: false;
    in-out property <bool> link-import: false;
    in-out property <string> repository-url;
    in-out property <string> repository-branch;
    in-out property <string> schedule-text;
    in-out property <string> activity-text;
    in-out property <string> error-text;
    in-out property <string> notice-text;
    in-out property <string> notice-detail;
    in-out property <string> storage-path;
    in-out property <string> empty-text;
    callback change-view(int);
    callback search(string);
    callback filter-changed;
    callback select(string);
    callback refresh;
    callback update-all;
    callback set-daily(bool);
    callback add-repository;
    callback remove-repository(string);
    callback import-folder;
    callback toggle-app(int, bool);
    callback toggle-row-app(string, int, bool);
    callback toggle-select(string, bool);
    callback toggle-select-all(bool);
    callback batch-app(int, bool);
    callback install;
    callback update-selected;
    callback uninstall;
    callback show-details;
    callback open-source(string);
}

export component SkillsPage inherits Rectangle {
    horizontal-stretch: 1;
    in property <bool> english;
    in property <bool> enabled: true;
    private property <bool> editable: root.enabled && SkillsState.loaded && !SkillsState.busy && !SkillsState.submitting;
    public function focus-search() {
        if SkillsState.view == 3 { repository-url.focus(); }
        else { search.focus(); }
    }

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            height: 36px;
            spacing: 4px;
            ActionButton { text: root.english ? "Installed" : "已安装"; primary: SkillsState.view == 0; subtle: SkillsState.view != 0; clicked => { SkillsState.change-view(0); } }
            ActionButton { text: root.english ? "Discover" : "发现"; primary: SkillsState.view == 1; subtle: SkillsState.view != 1; clicked => { SkillsState.change-view(1); } }
            ActionButton { text: root.english ? "On this device" : "本机技能"; primary: SkillsState.view == 2; subtle: SkillsState.view != 2; clicked => { SkillsState.change-view(2); } }
            ActionButton { text: root.english ? "Repositories" : "仓库"; primary: SkillsState.view == 3; subtle: SkillsState.view != 3; clicked => { SkillsState.change-view(3); } }
            Rectangle { horizontal-stretch: 1; }
            if SkillsState.view == 0: Rectangle {
                horizontal-stretch: 0;
                HorizontalLayout {
                    spacing: 8px;
                    padding-right: 4px;
                    Text { text: root.english ? "Daily update" : "每日更新"; color: Theme.secondary; font-size: 12px; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked <=> SkillsState.daily-update;
                            enabled: root.editable;
                            accessible-label: root.english ? "Daily update" : "每日更新";
                            toggled => { SkillsState.set-daily(self.checked); }
                        }
                    }
                }
                Tooltip { SkillPathHint { text: root.english ? "Updates every 24 hours while the toolbox is running in the tray; catches up at the next startup.\n" + SkillsState.schedule-text : "工具箱在托盘运行时每 24 小时更新；错过的更新会在下次启动时补上。\n" + SkillsState.schedule-text; } }
            }
            if SkillsState.view == 0: ActionButton {
                text: root.english ? "Update all" : "全部更新";
                with-icon: true;
                icon: @image-url("icons/download.svg");
                enabled: root.editable && SkillsState.installed-count > 0;
                clicked => { SkillsState.update-all(); }
            }
            if SkillsState.view == 2: CheckBox {
                text: root.english ? "Link (no copy)" : "链接（不复制）";
                checked <=> SkillsState.link-import;
                enabled: root.editable;
                accessible-label: root.english ? "Import local folders as links instead of copies" : "本地目录以链接方式导入而不是复制";
                Tooltip { SkillPathHint { text: root.english ? "Link keeps the source live and creates app symlinks on Windows; copy stores a private master copy. Existing app links to the same source are adopted." : "链接保留源目录并在应用目录创建符号链接（Windows 需要符号链接权限）；复制保存私有主副本。已存在且指向同一来源的应用链接会被接管。"; } }
            }
            if SkillsState.view == 2: ActionButton {
                text: root.english ? "Import folder" : "导入文件夹";
                with-icon: true;
                icon: @image-url("icons/folder.svg");
                enabled: root.editable;
                clicked => { SkillsState.import-folder(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                visible: SkillsState.view != 3;
                spacing: 10px;
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    search := LineEdit {
                        text <=> SkillsState.query;
                        placeholder-text: root.english ? "Search skills or repositories…" : "搜索技能名称、描述或仓库…";
                        enabled: root.enabled;
                        horizontal-stretch: 1;
                        edited => { SkillsState.search(self.text); }
                    }
                    ActionButton {
                        text: SkillsState.view == 1 ? (root.english ? "Reload repositories" : "刷新仓库") : SkillsState.view == 2 ? (root.english ? "Scan this device" : "扫描本机") : (root.english ? "Refresh" : "刷新");
                        with-icon: true;
                        icon: @image-url("icons/refresh.svg");
                        enabled: root.enabled && !SkillsState.loading && !SkillsState.submitting && (SkillsState.view == 0 || (SkillsState.loaded && !SkillsState.busy));
                        clicked => { SkillsState.refresh(); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    Card {
                        horizontal-stretch: 1;
                        min-width: 200px;
                        clip: true;
                        VerticalLayout {
                            if SkillsState.view == 0: Rectangle {
                                height: 38px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    CheckBox {
                                        text: root.english ? "Select all" : "全选";
                                        checked <=> SkillsState.all-selected;
                                        enabled: root.editable && SkillsState.rows.length > 0;
                                        toggled => { SkillsState.toggle-select-all(self.checked); }
                                    }
                                    Text { text: root.english ? "Selected" : "已选"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                    Text { text: SkillsState.selected-count; color: Theme.text; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    Rectangle { width: 10px; }
                                    Text { text: root.english ? "Status" : "状态"; color: Theme.muted; font-size: 11px; horizontal-stretch: 0; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        ComboBox {
                                            width: 90px;
                                            height: 26px;
                                            horizontal-stretch: 0;
                                            model: root.english ? ["All", "Enabled", "Disabled"] : ["全部", "已启用", "未启用"];
                                            current-index <=> SkillsState.status-filter;
                                            enabled: root.enabled;
                                            selected => { SkillsState.filter-changed(); }
                                        }
                                    }
                                    Text { text: root.english ? "Source" : "来源"; color: Theme.muted; font-size: 11px; horizontal-stretch: 0; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        ComboBox {
                                            width: 160px;
                                            height: 26px;
                                            horizontal-stretch: 0;
                                            model: SkillsState.source-options;
                                            current-index <=> SkillsState.source-filter;
                                            enabled: root.enabled;
                                            selected => { SkillsState.filter-changed(); }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        HorizontalLayout {
                                            width: 142px;
                                            spacing: 3px;
                                            alignment: center;
                                            padding-top: 8px;
                                            padding-bottom: 8px;
                                            AppToggle {
                                                icon: @image-url("icons/apps/claude.svg");
                                                name: "Claude Code";
                                                checked: SkillsState.batch-app0;
                                                enabled: root.editable && SkillsState.selected-count > 0;
                                                toggled(value) => { SkillsState.batch-app(0, value); }
                                            }
                                            AppToggle {
                                                icon: @image-url("icons/apps/codex.svg");
                                                name: "Codex";
                                                checked: SkillsState.batch-app1;
                                                enabled: root.editable && SkillsState.selected-count > 0;
                                                toggled(value) => { SkillsState.batch-app(1, value); }
                                            }
                                            AppToggle {
                                                icon: @image-url("icons/apps/gemini.svg");
                                                name: "Gemini CLI";
                                                checked: SkillsState.batch-app2;
                                                enabled: root.editable && SkillsState.selected-count > 0;
                                                toggled(value) => { SkillsState.batch-app(2, value); }
                                            }
                                            AppToggle {
                                                icon: @image-url("icons/apps/opencode.svg");
                                                name: "OpenCode";
                                                checked: SkillsState.batch-app3;
                                                enabled: root.editable && SkillsState.selected-count > 0;
                                                toggled(value) => { SkillsState.batch-app(3, value); }
                                            }
                                            AppToggle {
                                                icon: @image-url("icons/apps/grok.svg");
                                                name: "Grok Build";
                                                checked: SkillsState.batch-app4;
                                                enabled: root.editable && SkillsState.selected-count > 0;
                                                toggled(value) => { SkillsState.batch-app(4, value); }
                                            }
                                        }
                                        Rectangle { width: 28px; height: 1px; }
                                    }
                                }
                            }
                            if SkillsState.view == 0: Divider {}
                            ScrollView {
                                visible: SkillsState.rows.length > 0;
                                horizontal-scrollbar-policy: always-off;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 3px;
                                    for item in SkillsState.rows: Rectangle {
                                        height: SkillsState.view == 0 ? 54px : 82px;
                                        border-radius: 6px;
                                        background: SkillsState.selected-id == item.id ? Theme.accent-soft : row-touch.has-hover ? Theme.hover : transparent;
                                        border-width: row-keys.has-focus ? 2px : 0px;
                                        border-color: Theme.focus;
                                        accessible-role: button;
                                        accessible-label: item.name + " " + item.detail;
                                        accessible-action-default => { SkillsState.select(item.id); }
                                        forward-focus: row-keys;
                                        row-touch := TouchArea {
                                            enabled: root.enabled;
                                            mouse-cursor: pointer;
                                            clicked => { row-keys.focus(); SkillsState.select(item.id); }
                                        }
                                        // Columns: [select 22] text... [apps 142] [menu 28]. The batch
                                        // header uses the same widths and 12px edges, so icons line up.
                                        HorizontalLayout {
                                            padding: SkillsState.view == 0 ? 6px : 12px;
                                            spacing: 10px;
                                            if SkillsState.view == 0: CheckBox {
                                                width: 22px;
                                                checked: item.selected;
                                                enabled: root.editable;
                                                accessible-label: root.english ? "Select " + item.name : "选择 " + item.name;
                                                toggled => { SkillsState.toggle-select(item.id, self.checked); }
                                            }
                                            Rectangle {
                                              horizontal-stretch: 1;
                                              if item.description != "": Tooltip { SkillPathHint { text: item.description; } }
                                              VerticalLayout {
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: item.name;
                                                        color: Theme.text;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        overflow: elide;
                                                        min-width: 0px;
                                                        horizontal-stretch: 0;
                                                    }
                                                    if SkillsState.view == 0: SkillChip {
                                                        text: item.source;
                                                        link: item.source-target;
                                                        link-hint: (item.source-target.starts-with("https://") ? (root.english ? "Open repository: " : "打开仓库：") : (root.english ? "Open folder: " : "打开目录：")) + item.source-target;
                                                        clicked => { SkillsState.open-source(item.source-target); }
                                                    }
                                                    if SkillsState.view == 0: SkillChip { text: item.status; accent: item.enabled; }
                                                    if item.problem: Icon { source: @image-url("icons/warning.svg"); width: 14px; colorize: Theme.warning; }
                                                    if item.installed && SkillsState.view == 1: Icon { source: @image-url("icons/check.svg"); width: 14px; colorize: Theme.success; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text { text: item.description; color: Theme.secondary; font-size: 11px; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
                                                if SkillsState.view != 0: Text { text: item.detail; color: Theme.muted; font-size: 10px; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
                                              }
                                            }
                                            if SkillsState.view == 0: HorizontalLayout {
                                                width: 142px;
                                                spacing: 3px;
                                                alignment: center;
                                                padding-top: 10px;
                                                padding-bottom: 10px;
                                            AppToggle {
                                                icon: @image-url("icons/apps/claude.svg");
                                                name: "Claude Code";
                                                checked: item.app0;
                                                enabled: root.editable;
                                                toggled(value) => { SkillsState.toggle-row-app(item.id, 0, value); }
                                            }
                                            AppToggle {
                                                icon: @image-url("icons/apps/codex.svg");
                                                name: "Codex";
                                                checked: item.app1;
                                                enabled: root.editable;
                                                toggled(value) => { SkillsState.toggle-row-app(item.id, 1, value); }
                                            }
                                            AppToggle {
                                                icon: @image-url("icons/apps/gemini.svg");
                                                name: "Gemini CLI";
                                                checked: item.app2;
                                                enabled: root.editable;
                                                toggled(value) => { SkillsState.toggle-row-app(item.id, 2, value); }
                                            }
                                            AppToggle {
                                                icon: @image-url("icons/apps/opencode.svg");
                                                name: "OpenCode";
                                                checked: item.app3;
                                                enabled: root.editable;
                                                toggled(value) => { SkillsState.toggle-row-app(item.id, 3, value); }
                                            }
                                            AppToggle {
                                                icon: @image-url("icons/apps/grok.svg");
                                                name: "Grok Build";
                                                checked: item.app4;
                                                enabled: root.editable;
                                                toggled(value) => { SkillsState.toggle-row-app(item.id, 4, value); }
                                            }
                                            }
                                            if SkillsState.view == 0: VerticalLayout {
                                                alignment: center;
                                                RowMenuButton {
                                                    tip: root.english ? "More actions" : "更多操作";
                                                    enabled: root.enabled;
                                                    clicked => {
                                                        SkillsState.select(item.id);
                                                        row-menu.show();
                                                    }
                                                }
                                            }
                                        }
                                        // Opens under the "···" button with right edges aligned
                                        // (row padding 6px); it floats above the list, so rows keep their height.
                                        row-menu := PopupWindow {
                                            x: parent.width - self.width - 6px;
                                            y: 44px;
                                            width: 168px;
                                            close-policy: close-on-click-outside;
                                            Rectangle {
                                                border-radius: 8px;
                                                border-width: 1px;
                                                border-color: Theme.strong-border;
                                                background: Theme.surface;
                                                drop-shadow-blur: 14px;
                                                drop-shadow-offset-y: 4px;
                                                drop-shadow-color: #0000004d;
                                                VerticalLayout {
                                                    padding: 4px;
                                                    spacing: 2px;
                                                    SkillMenuItem {
                                                        icon: @image-url("icons/download.svg");
                                                        text: root.english ? "Update" : "更新";
                                                        hint: item.updatable ? "" : (root.english ? "Local" : "本机导入");
                                                        enabled: root.editable && item.updatable;
                                                        activated => {
                                                            row-menu.close();
                                                            SkillsState.select(item.id);
                                                            SkillsState.update-selected();
                                                        }
                                                    }
                                                    Rectangle { height: 1px; background: Theme.border; }
                                                    SkillMenuItem {
                                                        icon: @image-url("icons/trash.svg");
                                                        text: root.english ? "Uninstall..." : "卸载…";
                                                        danger: true;
                                                        enabled: root.editable;
                                                        activated => {
                                                            row-menu.close();
                                                            SkillsState.select(item.id);
                                                            SkillsState.uninstall();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        row-keys := FocusScope {
                                            enabled: root.enabled;
                                            focus-on-click: false;
                                            key-pressed(event) => {
                                                if event.text == Key.Return || event.text == Key.Space { SkillsState.select(item.id); return accept; }
                                                reject
                                            }
                                        }
                                    }
                                }
                            }
                            if SkillsState.rows.length == 0: VerticalLayout {
                                vertical-stretch: 1;
                                padding: 24px;
                                alignment: center;
                                spacing: 12px;
                                // Centre the fixed-size icon in a row: as a direct child its
                                // width would cap this column and, through it, the window.
                                HorizontalLayout {
                                    alignment: center;
                                    Icon { source: @image-url("icons/box.svg"); width: 28px; colorize: Theme.muted; }
                                }
                                Caption { text: SkillsState.empty-text; horizontal-alignment: center; }
                            }
                        }
                    }
                    if SkillsState.view != 0: Card {
                        width: 282px;
                        clip: true;
                        VerticalLayout {
                            padding: 15px;
                            spacing: 10px;
                            ScrollView {
                                vertical-stretch: 1;
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout {
                                    padding-right: 4px;
                                    spacing: 10px;
                                    if SkillsState.selected-id == "": Caption { text: root.english ? "Select a skill to view details and choose deployment directories." : "选择一个技能，查看详情并管理部署目录。"; }
                                    if SkillsState.selected-id != "": VerticalLayout {
                                        spacing: 10px;
                                        Text { text: SkillsState.selected-name; color: Theme.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                                        Caption { text: SkillsState.selected-source; font-size: 11px; }
                                        if SkillsState.selected-error != "": Caption { text: SkillsState.selected-error; color: Theme.danger; font-size: 11px; }
                                        Divider {}
                                        SectionLabel { text: SkillsState.view == 0 ? (root.english ? "DEPLOY TO APP DIRECTORIES" : "应用目录部署") : (root.english ? "DEPLOY AFTER IMPORT" : "安装后部署到"); }
                                        VerticalLayout {
                                            spacing: 2px;
                                            for app in SkillsState.apps: Rectangle {
                                                height: 28px;
                                                HorizontalLayout {
                                                    spacing: 0px;
                                                    CheckBox {
                                                        text: app.name;
                                                        checked <=> app.enabled;
                                                        enabled: root.editable && (SkillsState.view == 0 || !SkillsState.selected-installed);
                                                        toggled => { SkillsState.toggle-app(app.index, self.checked); }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Tooltip { SkillPathHint { text: app.name + "\n" + app.path; } }
                                            }
                                        }
                                        Caption { text: root.english ? "Hover an app for its path. Switches manage only these directories; apps may also read Claude, project or other skills directories." : "悬停应用可查看路径。开关只管理这些目录；应用也可能读取 Claude 或项目等其他 Skills 目录。"; font-size: 11px; }
                                        Divider {}
                                        Caption { text: SkillsState.selected-description; color: Theme.secondary; }
                                        if SkillsState.selected-detail != "": Caption { text: SkillsState.selected-detail; font-size: 11px; }
                                        if SkillsState.view != 0: Caption { text: root.english ? "Leave all unchecked to keep only a managed copy or link." : "可不勾选应用，仅保存管理副本或链接。"; font-size: 11px; }
                                        if SkillsState.view == 2 && SkillsState.selected-linked: Caption { text: root.english ? "This source is a link. “Link (no copy)” keeps it live; importing a copy reads its real target." : "该来源是链接。“链接（不复制）”保留实时源；复制会读取其真实目标。"; font-size: 11px; }
                                        if SkillsState.view == 2 && !SkillsState.selected-linked: Caption { text: root.english ? "The original folder is kept. Move it aside before deploying to the same directory." : "导入会保留原文件夹；部署到同名目录前，请先手动移开原目录。"; font-size: 11px; }
                                        if SkillsState.view == 0 && SkillsState.selected-linked: Caption { text: root.english ? "Managed as a link: app switches create or remove symlinks, and the source is not copied." : "以链接方式管理：应用开关创建或移除符号链接，不复制源目录。"; font-size: 11px; }
                                        if SkillsState.view == 0 && !SkillsState.selected-updatable: Caption { text: root.english ? "Local imports have no remote update source." : "本机导入的技能没有远程更新来源。"; font-size: 11px; }
                                    }
                                    Rectangle { min-height: 0px; vertical-stretch: 1; }
                                }
                            }
                            if SkillsState.selected-id != "" && SkillsState.view != 0: ActionButton {
                                text: SkillsState.selected-installed ? (root.english ? "Already installed" : "已安装") : SkillsState.view == 2 ? (SkillsState.link-import ? (root.english ? "Import as link" : "以链接导入") : (root.english ? "Import as copy" : "以复制导入")) : (root.english ? "Install selected" : "安装所选技能");
                                primary: true;
                                enabled: root.editable && !SkillsState.selected-installed;
                                clicked => { SkillsState.install(); }
                            }
                            if SkillsState.selected-id != "" && SkillsState.view == 0: HorizontalLayout {
                                spacing: 8px;
                                ActionButton { text: root.english ? "Update" : "更新"; enabled: root.editable && SkillsState.selected-updatable; clicked => { SkillsState.update-selected(); } }
                                ActionButton { text: root.english ? "Uninstall" : "卸载"; danger: true; enabled: root.editable; clicked => { SkillsState.uninstall(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                }

            VerticalLayout {
                visible: SkillsState.view == 3;
                spacing: 12px;
                Card {
                    VerticalLayout {
                        padding: 15px;
                        spacing: 9px;
                        FieldLabel { text: root.english ? "GitHub skill repository" : "GitHub 技能仓库"; }
                        repository-url := LineEdit { text <=> SkillsState.repository-url; placeholder-text: "owner/repo · https://github.com/owner/repo"; enabled: root.editable; }
                        HorizontalLayout {
                            spacing: 9px;
                            LineEdit { text <=> SkillsState.repository-branch; placeholder-text: root.english ? "Branch (blank = default)" : "分支（留空使用默认分支）"; enabled: root.editable; }
                            ActionButton { text: root.english ? "Add repository" : "添加仓库"; primary: true; enabled: root.editable && SkillsState.repository-url != ""; clicked => { SkillsState.add-repository(); } }
                        }
                        Caption { text: root.english ? "After adding a source, open Discover and reload repositories. Git must be installed." : "添加后前往「发现」刷新仓库，即可选择安装。需已安装 Git。"; font-size: 11px; }
                    }
                }
                Card {
                    vertical-stretch: 1;
                    clip: true;
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            if SkillsState.repositories.length == 0: Caption { text: root.english ? "Add a repository above to discover its skills." : "在上方添加仓库，开始发现技能。"; }
                            for repo in SkillsState.repositories: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text { text: repo.url; color: Theme.text; font-size: 12px; overflow: elide; min-width: 0px; }
                                        Caption { text: repo.detail; font-size: 11px; }
                                    }
                                    ActionButton { text: root.english ? "Remove" : "移除"; subtle: true; danger: true; enabled: root.editable && repo.removable; clicked => { SkillsState.remove-repository(repo.id); } }
                                }
                                if repo.error != "": Caption { text: repo.error; color: Theme.danger; font-size: 11px; }
                                Divider {}
                            }
                            Rectangle { min-height: 0px; vertical-stretch: 1; }
                        }
                    }
                }
                Caption { text: (root.english ? "Managed copies: " : "管理副本：") + SkillsState.storage-path; font-size: 11px; }
            }
        }

        // One status line: activity or error, then a summarised notice whose
        // full text is in the tooltip and the details dialog. No max-width:
        // a capped child would cap the whole page column in the window layout.
        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            if SkillsState.busy || SkillsState.submitting || SkillsState.loading: VerticalLayout {
                alignment: center;
                Spinner { width: 15px; height: 15px; }
            }
            Caption {
                text: SkillsState.error-text != "" ? SkillsState.error-text : SkillsState.activity-text;
                color: SkillsState.error-text != "" ? Theme.danger : Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                min-width: 0px;
                horizontal-stretch: 1;
            }
            if SkillsState.notice-text != "": Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                HorizontalLayout {
                    spacing: 6px;
                    Icon { source: @image-url("icons/warning.svg"); width: 13px; colorize: Theme.warning; }
                    Caption {
                        text: SkillsState.notice-text;
                        color: Theme.warning;
                        font-size: 11px;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                }
                Tooltip { SkillPathHint { text: SkillsState.notice-detail; } }
            }
            if SkillsState.error-text != "" || SkillsState.notice-text != "": ActionButton {
                text: root.english ? "Details" : "查看详情";
                subtle: true;
                height: 28px;
                clicked => { SkillsState.show-details(); }
            }
        }
    }
}
