// Stable Slint ownership for messages shared with Rust. A label may be used by
// a direct binding or a Rust-formatted model, independently of the active layout.
export global SharedMessages {
    out property <string> all: @tr("ui.common.all" => "All");
    out property <string> at-mouse-pointer: @tr("ui.common.at_mouse_pointer" => "At mouse pointer");
    out property <string> available: @tr("ui.common.available" => "Available");
    out property <string> bottom: @tr("ui.common.bottom" => "Bottom");
    out property <string> dark: @tr("ui.common.dark" => "Dark");
    out property <string> disabled: @tr("ui.common.disabled" => "Disabled");
    out property <string> enabled: @tr("ui.common.enabled" => "Enabled");
    out property <string> left: @tr("ui.common.left" => "Left");
    out property <string> light: @tr("ui.common.light" => "Light");
    out property <string> local: @tr("ui.common.local" => "Local");
    out property <string> primary-display: @tr("ui.common.primary_display" => "Primary display");
    out property <string> reading-recent-projects: @tr("ui.common.reading_recent_projects" => "Reading recent projects…");
    out property <string> recent-projects: @tr("ui.common.recent_projects" => "Recent projects");
    out property <string> right: @tr("ui.common.right" => "Right");
    out property <string> settings: @tr("ui.common.settings" => "Settings");
    out property <string> skills: @tr("ui.common.skills" => "Skills");
    out property <string> system: @tr("ui.common.system" => "System");
    out property <string> top: @tr("ui.common.top" => "Top");
    out property <string> unavailable: @tr("ui.common.unavailable" => "Unavailable");
    out property <string> with-foreground-window: @tr("ui.common.with_foreground_window" => "With foreground window");
}
